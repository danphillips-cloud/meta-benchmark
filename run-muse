#!/usr/bin/env python3
"""One-command meta-benchmark launcher.

Usage:
  ./run-muse                     interactive prompt loop
  ./run-muse "Say hi"            single prompt run
  ./run-muse --compare "Say hi"  same prompt across configured models
  ./run-muse --minimal "Say hi"  controlled context (repeatable tests)

Starts the log UI in the background if needed, runs each prompt, and
appends the result to muse-runs/ for the UI to display. Meta runs use
the Muse subscription login. Direct API providers use their own key.
"""
import argparse
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
import uuid
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))
from muse_log import build_timeline, harvest_calls  # noqa: E402

ROOT = Path(__file__).parent


def load_dotenv(path=None):
    """Load KEY=VALUE lines from the repo-root .env into os.environ.

    Blank lines and # comments are skipped, surrounding quotes are
    stripped, and a variable already set in the environment wins.
    Values are never printed or logged.
    """
    path = path if path is not None else ROOT / ".env"
    if not Path(path).is_file():
        return
    for line in Path(path).read_text(errors="replace").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        if key:
            os.environ.setdefault(key, value)


load_dotenv()
RUNS = ROOT / "muse-runs"
UI_DIR = ROOT
PORT = int(os.environ.get("PORT", "8765"))
UI_URL = f"http://127.0.0.1:{PORT}/"
DEFAULT_MODEL = os.environ.get("MUSE_MODEL", "muse-wonder-full-1.0")
DEFAULT_CLAUDE_MODEL = os.environ.get("BENCH_CLAUDE_MODEL", "claude-sonnet-5-5")
DEFAULT_PROVIDER = os.environ.get("MUSE_PROVIDER", "meta")
STRIP_ENV = ("META_API_KEY", "MUSE_API_TOKEN", "MODEL_API_KEY", "ANTHROPIC_API_KEY")
# provider:model entries used by --compare
COMPARE_MODELS = os.environ.get(
    "COMPARE_MODELS",
    "meta:muse-wonder-1.0,claude-code:muse-wonder-1.0,"
    "claude-code:claude-sonnet-5-5")
COMPARE_META = os.environ.get(
    "COMPARE_META", "meta:muse-wonder-full-1.0,meta:muse-wonder-1.0")
COMPARE_CLAUDE = os.environ.get(
    "COMPARE_CLAUDE",
    "claude-code:muse-wonder-1.0,claude-code:claude-sonnet-5-5")
COMPARE_MODES = ("meta", "claude", "custom")


def default_model(provider):
    # Not ANTHROPIC_MODEL: Meta's Claude Code setup tells users to
    # export that name for a Meta model, which must not silently
    # change this tool's Claude default.
    if provider in ("anthropic", "claude-code"):
        return os.environ.get("BENCH_CLAUDE_MODEL", DEFAULT_CLAUDE_MODEL)
    return os.environ.get("MUSE_MODEL", DEFAULT_MODEL)


def endpoint_for(model):
    """The model id picks the endpoint. muse-* goes to Meta's
    Anthropic-compatible API, anything else goes to Anthropic."""
    if model and model.startswith("muse-"):
        return (os.environ.get("META_BASE_URL",
                               "https://api.meta.ai").rstrip("/"),
                os.environ.get("MODEL_API_KEY"))
    return (os.environ.get("ANTHROPIC_BASE_URL",
                           "https://api.anthropic.com").rstrip("/"),
            os.environ.get("ANTHROPIC_API_KEY"))


def endpoint_key_name(model):
    return "MODEL_API_KEY" if model and model.startswith("muse-") \
        else "ANTHROPIC_API_KEY"


PAID_PROVIDERS = ("claude-code", "anthropic")


def default_timeout(provider):
    return 300 if provider in PAID_PROVIDERS else 1800


def paid_notice(model):
    return f"Paid run: uses {endpoint_key_name(model)}"


def ui_version():
    try:
        m = re.search(r"(?m)^VERSION\s*=\s*(\d+)",
                      (UI_DIR / "server.py").read_text())
        return int(m.group(1)) if m else None
    except Exception:
        return None


def fetch_ui_logs():
    try:
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        with opener.open(UI_URL + "api/logs", timeout=2) as resp:
            return json.loads(resp.read().decode())
    except Exception:
        return None


def ui_up():
    return fetch_ui_logs() is not None


def start_ui():
    RUNS.mkdir(exist_ok=True)
    log = open(RUNS / "server.log", "ab")
    try:
        subprocess.Popen([sys.executable, str(UI_DIR / "server.py")],
                         cwd=UI_DIR, stdout=log, stderr=log,
                         env={**os.environ, "PORT": str(PORT)},
                         start_new_session=True)
    finally:
        log.close()
    for _ in range(20):
        if ui_up():
            break
        time.sleep(0.25)


def _pids_on_port(port):
    if shutil.which("lsof"):
        return subprocess.run(["lsof", "-ti", f"tcp:{port}"],
                              capture_output=True, text=True).stdout.split()
    if shutil.which("ss"):
        out = subprocess.run(["ss", "-tlnp", f"sport = :{port}"],
                             capture_output=True, text=True).stdout
        return sorted(set(re.findall(r"pid=(\d+)", out)))
    if shutil.which("fuser"):
        out = subprocess.run(["fuser", f"{port}/tcp"],
                             capture_output=True, text=True).stdout
        return [p for p in out.replace(",", " ").split() if p.isdigit()]
    return []


def _pid_cmdline(pid):
    proc = Path(f"/proc/{pid}/cmdline")
    if proc.is_file():
        return proc.read_bytes().replace(b"\0", b" ").decode(errors="replace")
    return subprocess.run(["ps", "-p", pid, "-o", "command="],
                          capture_output=True, text=True).stdout


def _pid_cwd(pid):
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        pass
    if shutil.which("lsof"):
        cwd_out = subprocess.run(["lsof", "-a", "-p", pid, "-d", "cwd", "-Fn"],
                                 capture_output=True, text=True).stdout
        return next((l[1:] for l in cwd_out.splitlines() if l.startswith("n")), "")
    return ""


def restart_ui():
    for pid in _pids_on_port(PORT):
        cmdline = _pid_cmdline(pid)
        cwd = _pid_cwd(pid)
        is_ours = "server.py" in cmdline and (
            str(UI_DIR) in cmdline or cwd == str(UI_DIR))
        if is_ours:
            subprocess.run(["kill", pid], capture_output=True)
        else:
            print(f"Port {PORT} is held by another process (pid {pid}), "
                  "not the Muse UI. Leaving it alone.", file=sys.stderr)
            return
    for _ in range(20):
        if not ui_up():
            break
        time.sleep(0.25)
    start_ui()


def ensure_ui():
    if os.environ.get("RUN_MUSE_NO_UI"):
        return
    logs = fetch_ui_logs()
    opened = False
    if logs is None:
        start_ui()
        opened = True
    elif logs.get("version") != ui_version():
        print("Updating the log UI to the current version…")
        restart_ui()
        opened = True
    # Only open a tab when we actually started or updated the server.
    # If the page is already up, the user already has it in a tab.
    if opened and sys.platform == "darwin":
        subprocess.run(["open", UI_URL], capture_output=True)
    elif opened and sys.platform.startswith("linux") and shutil.which("xdg-open"):
        subprocess.run(["xdg-open", UI_URL], capture_output=True)


def run_process(cmd, cwd, env, stdout_path, timeout, input_text=None):
    """Run one harness process, writing stdout to stdout_path and
    stderr to the sibling stderr.log. Returns exit state plus the
    stdout lines stamped with arrival time in ms since start."""
    started = time.monotonic()
    lines = []
    timed_out = False
    interrupted = False
    with open(stdout_path, "w") as out, \
            open(stdout_path.with_name("stderr.log"), "w") as err:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=err,
                                stdin=subprocess.PIPE if input_text is not None else None,
                                env=env, cwd=cwd, start_new_session=True,
                                text=True, errors="replace")

        def reader():
            for line in proc.stdout:
                lines.append((round((time.monotonic() - started) * 1000), line))
                out.write(line)
                out.flush()

        def writer():
            try:
                proc.stdin.write(input_text)
                proc.stdin.close()
            except (BrokenPipeError, OSError):
                pass

        read_thread = threading.Thread(target=reader, daemon=True)
        read_thread.start()
        if input_text is not None:
            threading.Thread(target=writer, daemon=True).start()
        try:
            exit_code = proc.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            timed_out = True
            os.killpg(proc.pid, signal.SIGTERM)
            try:
                exit_code = proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                os.killpg(proc.pid, signal.SIGKILL)
                exit_code = proc.wait()
        except KeyboardInterrupt:
            interrupted = True
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            try:
                exit_code = proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                os.killpg(proc.pid, signal.SIGKILL)
                exit_code = proc.wait()
        read_thread.join(timeout=5)
    return {
        "wall_ms": round((time.monotonic() - started) * 1000),
        "exit_code": exit_code, "timed_out": timed_out,
        "interrupted": interrupted, "lines": lines,
    }


def run_muse_exec(prompt, run_dir, provider, model, minimal, timeout,
                  session_id=None):
    """Run one prompt through Muse. Returns report fields."""
    session_id = session_id or str(uuid.uuid4())
    workspace = run_dir / "workspace"
    workspace.mkdir()
    (run_dir / "prompt.md").write_text(prompt)
    env = {k: v for k, v in os.environ.items() if k not in STRIP_ENV}
    cmd = ["muse", "exec", "--json", "--provider", provider,
           "--prompt-file", str(run_dir / "prompt.md"),
           "--workspace", str(workspace),
           "--session-id", session_id]
    if provider != "echo":
        cmd += ["--model", model]
    if minimal:
        cmd += ["--disable-reminders", "--no-foreign-personal-context"]
    proc = run_process(cmd, workspace, env, run_dir / "events.jsonl", timeout)
    wall_ms = proc["wall_ms"]
    exit_code = proc["exit_code"]
    timed_out = proc["timed_out"]
    interrupted = proc["interrupted"]
    reply, usage_model = "", None
    for line in (run_dir / "events.jsonl").read_text(errors="replace").splitlines():
        try:
            e = json.loads(line)
        except Exception:
            continue
        payload = e.get("payload") or {}
        if payload.get("kind") == "run_terminal":
            reply = payload.get("text") or reply
        if payload.get("kind") == "run_usage":
            models = payload.get("models") or []
            if models and models[0].get("model"):
                usage_model = models[0]["model"]
    # Read the log once even after a timeout or Ctrl+C, so finished calls
    # are kept. Only wait for a late flush when the run exited cleanly.
    calls = harvest_calls(session_id) if provider != "echo" else []
    if not calls and provider != "echo" and exit_code == 0:
        for _ in range(10):
            time.sleep(0.5)
            calls = harvest_calls(session_id)
            if calls:
                break
    return {
        "session_id": session_id, "wall_ms": wall_ms,
        "exit_code": exit_code, "timed_out": timed_out,
        "interrupted": interrupted, "reply": reply,
        "calls": calls, "timeline": build_timeline(session_id, wall_ms),
        "command": " ".join(cmd), "usage_model": usage_model,
    }


def run_anthropic(prompt, run_dir, model, timeout):
    """One direct Anthropic Messages API call. No agent context."""
    base, api_key = endpoint_for(model)
    if not api_key:
        return {"session_id": None, "wall_ms": 0, "exit_code": 1,
                "timed_out": False, "interrupted": False, "reply": "", "calls": [], "timeline": [],
                "command": f"POST {base}/v1/messages",
                "usage_model": None,
                "error_override": f"{endpoint_key_name(model)} is not set"}
    max_tokens = int(os.environ.get("ANTHROPIC_MAX_TOKENS", "8192"))
    body = json.dumps({"model": model, "max_tokens": max_tokens,
                       "messages": [{"role": "user", "content": prompt}]}).encode()
    req = urllib.request.Request(base + "/v1/messages", data=body, method="POST",
        headers={"Content-Type": "application/json", "x-api-key": api_key,
                 "anthropic-version": "2023-06-01"})
    started = time.monotonic()
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.loads(resp.read().decode())
        exit_code, error = 0, None
    except urllib.error.HTTPError as e:
        data, exit_code = {}, e.code
        try:
            error = (json.loads(e.read().decode()).get("error") or {}).get("message")
        except Exception:
            error = f"HTTP {e.code}"
    except Exception as e:
        data, exit_code, error = {}, 1, str(e)
    wall_ms = round((time.monotonic() - started) * 1000)
    usage = data.get("usage") or {}
    reply = "".join(b.get("text", "") for b in (data.get("content") or [])
                    if b.get("type") == "text")
    calls = [{"model": data.get("model") or model, "duration_ms": wall_ms,
              "input_tokens": usage.get("input_tokens"),
              "output_tokens": usage.get("output_tokens"),
              "cached_tokens": usage.get("cache_read_input_tokens"),
              "reasoning_tokens": None,
              "stop_reason": data.get("stop_reason")}] if data else []
    timeline = [{"at": datetime.now(timezone.utc).isoformat(),
                 "operation": "model_completed", "duration_ms": 0,
                 "wire_ms": wall_ms}] if data else []
    (run_dir / "events.jsonl").write_text("")
    (run_dir / "stderr.log").write_text(error or "")
    return {"session_id": None, "wall_ms": wall_ms, "exit_code": exit_code,
            "timed_out": False, "interrupted": False, "reply": reply, "calls": calls,
            "timeline": timeline, "command": f"POST {base}/v1/messages",
            "usage_model": data.get("model"), "error_override": error}


def _input_with_cache(usage):
    parts = [usage.get("input_tokens"), usage.get("cache_read_input_tokens"),
             usage.get("cache_creation_input_tokens")]
    if all(p is None for p in parts):
        return None
    return sum(p or 0 for p in parts)


def parse_claude_stream(stamped):
    """Map stamped Claude Code stream-json lines onto report fields.

    stamped holds (arrival_ms, line) pairs from run_process. One call
    per unique assistant message.id. Claude Code reports no per-call
    duration, and per-call output counts are partial snapshots, so
    both stay None and output totals come from the result event.
    result.usage.iterations only holds the last call, so it is not used.
    """
    events = []
    for arrival, line in stamped:
        try:
            events.append((arrival, json.loads(line)))
        except Exception:
            continue
    calls, timeline, seen = [], [], set()
    result, session_id, usage_model = None, None, None
    for i, (arrival, e) in enumerate(events):
        session_id = session_id or e.get("session_id")
        etype = e.get("type")
        label = etype or "event"
        if e.get("subtype"):
            label += f" {e['subtype']}"
        nxt = events[i + 1][0] if i + 1 < len(events) else None
        timeline.append({
            "at": e.get("timestamp"), "operation": label,
            "duration_ms": (nxt - arrival) if nxt is not None else 0,
            "wire_ms": None,
        })
        if etype == "assistant":
            msg = e.get("message") or {}
            mid = msg.get("id")
            # Claude Code emits a "<synthetic>" message to carry an error.
            # It is not a model call.
            if msg.get("model") == "<synthetic>" or (mid and mid in seen):
                continue
            if mid:
                seen.add(mid)
            usage = msg.get("usage") or {}
            usage_model = msg.get("model") or usage_model
            # Meta's endpoint sends all-zero per-call usage. A real call
            # always has input, so 0 means not reported.
            input_tokens = _input_with_cache(usage) or None
            calls.append({
                "model": msg.get("model"), "duration_ms": None,
                "input_tokens": input_tokens,
                "output_tokens": None,
                "cached_tokens": usage.get("cache_read_input_tokens")
                                 if input_tokens else None,
                "reasoning_tokens": None,
            })
        elif etype == "result":
            result = e
    parsed = {"session_id": session_id, "reply": "", "calls": calls,
              "timeline": timeline, "usage_model": usage_model,
              "api_ms": None, "ttft_ms": None, "num_turns": None,
              "cost_usd": None, "totals": None, "is_error": False,
              "api_error_status": None}
    if result:
        usage = result.get("usage") or {}
        parsed.update({
            "session_id": result.get("session_id") or session_id,
            "reply": result.get("result") or "",
            "api_ms": result.get("duration_api_ms"),
            "ttft_ms": result.get("ttft_ms"),
            "num_turns": result.get("num_turns"),
            "cost_usd": result.get("total_cost_usd"),
            "is_error": bool(result.get("is_error")),
            "api_error_status": result.get("api_error_status"),
            "totals": {
                "input_tokens": _input_with_cache(usage),
                "output_tokens": usage.get("output_tokens"),
                "cached_tokens": usage.get("cache_read_input_tokens"),
            },
        })
        models = list((result.get("modelUsage") or {}).keys())
        if models and not parsed["usage_model"]:
            parsed["usage_model"] = models[0]
    return parsed


def run_claude_code(prompt, run_dir, model, timeout):
    """Run one prompt through Claude Code in --bare mode."""
    workspace = run_dir / "workspace"
    workspace.mkdir()
    (run_dir / "prompt.md").write_text(prompt)
    # Bare mode defaults to auto, which asks the session model to
    # classify each Bash call. muse-wonder-1.0 cannot do that, so
    # every Bash call is denied as "Classifier unavailable".
    # --allowedTools alone does not skip the classifier. dontAsk
    # never consults it: the three tools bare mode exposes run,
    # anything else is denied.
    cmd = ["claude", "-p", "--bare", "--output-format", "stream-json",
           "--verbose", "--model", model,
           "--permission-mode", "dontAsk",
           "--allowedTools", "Bash,Edit,Read"]
    base, api_key = endpoint_for(model)
    if not api_key:
        return {"session_id": None, "wall_ms": 0, "exit_code": 1,
                "timed_out": False, "interrupted": False, "reply": "",
                "calls": [], "timeline": [], "command": " ".join(cmd),
                "usage_model": None,
                "error_override": f"{endpoint_key_name(model)} is not set"}
    env = {k: v for k, v in os.environ.items() if k not in STRIP_ENV}
    env["ANTHROPIC_API_KEY"] = api_key
    env["ANTHROPIC_BASE_URL"] = base
    env["ANTHROPIC_DEFAULT_HAIKU_MODEL"] = model
    env["ANTHROPIC_DEFAULT_SONNET_MODEL"] = model
    env["ANTHROPIC_DEFAULT_OPUS_MODEL"] = model
    try:
        proc = run_process(cmd, workspace, env, run_dir / "events.jsonl",
                           timeout, input_text=prompt)
    except OSError as e:
        return {"session_id": None, "wall_ms": 0, "exit_code": 1,
                "timed_out": False, "interrupted": False, "reply": "",
                "calls": [], "timeline": [], "command": " ".join(cmd),
                "usage_model": None, "error_override": str(e)}
    parsed = parse_claude_stream(proc["lines"])
    exit_code = proc["exit_code"]
    error = None
    if parsed["is_error"]:
        if exit_code == 0:
            exit_code = 1
        error = parsed["reply"] or (
            f"api_error_status {parsed['api_error_status']}"
            if parsed["api_error_status"] else "Claude Code reported an error")
    return {
        "session_id": parsed["session_id"], "wall_ms": proc["wall_ms"],
        "exit_code": exit_code, "timed_out": proc["timed_out"],
        "interrupted": proc["interrupted"], "reply": parsed["reply"],
        "calls": parsed["calls"], "timeline": parsed["timeline"],
        "command": " ".join(cmd), "usage_model": parsed["usage_model"],
        "error_override": error, "api_ms": parsed["api_ms"],
        "ttft_ms": parsed["ttft_ms"], "num_turns": parsed["num_turns"],
        "cost_usd": parsed["cost_usd"], "totals": parsed["totals"],
    }


def run_prompt(prompt, provider=DEFAULT_PROVIDER, model=None,
               minimal=False, timeout=None, comparison_id=None,
               compare_round=None, compare_mode=None):
    model = model or default_model(provider)
    if timeout is None:
        timeout = default_timeout(provider)
    if provider in PAID_PROVIDERS:
        print(paid_notice(model))
    RUNS.mkdir(exist_ok=True)
    run_id = datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:6]
    run_dir = RUNS / run_id
    run_dir.mkdir()
    # Register the run immediately so the UI shows it while it runs.
    # The final summary is appended again at the end; the UI keeps the
    # last entry per run_id.
    live_session_id = str(uuid.uuid4()) \
        if provider not in ("anthropic", "claude-code") else None
    context_mode = "bare" if provider == "claude-code" \
        else ("minimal" if minimal else "full")
    running = {
        "at": datetime.now(timezone.utc).isoformat(),
        "run_id": run_id, "prompt": prompt,
        "model": model if provider != "echo" else "echo",
        "provider": provider, "session_id": live_session_id,
        "context_mode": context_mode,
        "comparison_id": comparison_id, "round": compare_round,
        "compare_mode": compare_mode,
        "status": "running",
        "timeout_seconds": timeout, "command": None,
        "wall_ms": None, "exit_code": None, "reply": "",
        "calls": [], "metrics_unavailable": False, "error": None,
    }
    with open(RUNS / "index.jsonl", "a") as f:
        f.write(json.dumps(running) + "\n")
    started = time.monotonic()
    try:
        if provider == "anthropic":
            r = run_anthropic(prompt, run_dir, model, timeout)
        elif provider == "claude-code":
            r = run_claude_code(prompt, run_dir, model, timeout)
        else:
            r = run_muse_exec(prompt, run_dir, provider, model, minimal, timeout,
                              session_id=live_session_id)
    except KeyboardInterrupt:
        # Ctrl+C during a direct API call, or outside proc.wait() in
        # run_muse_exec, must still write a final status below.
        r = {"session_id": live_session_id,
             "wall_ms": round((time.monotonic() - started) * 1000),
             "exit_code": 130, "timed_out": False, "interrupted": True,
             "reply": "", "calls": [], "timeline": [], "command": None,
             "usage_model": None}
    if r["timed_out"]:
        status = "timeout"
    elif r.get("interrupted"):
        status = "interrupted"
    elif r["exit_code"] != 0:
        status = "failed"
    else:
        status = "completed"
    stderr_tail = ""
    err_file = run_dir / "stderr.log"
    if err_file.is_file():
        lines = err_file.read_text(errors="replace").strip().splitlines()
        stderr_tail = lines[-1] if lines else ""
    report = {
        "at": datetime.now(timezone.utc).isoformat(),
        "run_id": run_id, "prompt": prompt,
        "model": r.get("usage_model") or (model if provider != "echo" else "echo"),
        "provider": provider, "session_id": r["session_id"],
        "context_mode": context_mode,
        "comparison_id": comparison_id, "round": compare_round,
        "compare_mode": compare_mode,
        "status": status, "timeout_seconds": timeout,
        "command": r["command"],
        "wall_ms": r["wall_ms"], "exit_code": r["exit_code"],
        "reply": r["reply"], "calls": r["calls"], "timeline": r["timeline"],
        "api_ms": r.get("api_ms"), "ttft_ms": r.get("ttft_ms"),
        "num_turns": r.get("num_turns"), "cost_usd": r.get("cost_usd"),
        "totals": r.get("totals"),
        "metrics_unavailable": status == "completed" and not r["calls"],
        "error": r.get("error_override")
                 or (stderr_tail if status != "completed" else None),
    }
    (run_dir / "report.json").write_text(json.dumps(report, indent=2))
    summary = {k: v for k, v in report.items() if k != "timeline"}
    with open(RUNS / "index.jsonl", "a") as f:
        f.write(json.dumps(summary) + "\n")
    label = f"{provider}/{report['model']}"
    if report["metrics_unavailable"]:
        print(f"[{label}] wall {r['wall_ms']} ms · "
              "model metrics unavailable (no model records in session log)")
    else:
        durations = [c["duration_ms"] for c in r["calls"]
                     if c.get("duration_ms") is not None]
        model_ms = sum(durations) if durations else (r.get("api_ms") or 0)
        totals = r.get("totals") or {}
        in_tok = totals.get("input_tokens") if totals else \
            sum(c["input_tokens"] or 0 for c in r["calls"])
        out_tok = totals.get("output_tokens") if totals else \
            sum(c["output_tokens"] or 0 for c in r["calls"])
        print(f"[{label}] wall {r['wall_ms']} ms · model {model_ms} ms · "
              f"in {in_tok} · out {out_tok} · {len(r['calls'])} call(s) · {status}")
    if r["reply"]:
        print(r["reply"][:500])
    if status == "timeout":
        print(f"Timed out after {timeout} seconds. That is the run cap, "
              "not a crash. Partial files are in "
              f"{run_dir / 'workspace'}")
    elif status == "interrupted":
        print(f"Interrupted. The run was stopped and recorded. "
              f"Partial files are in {run_dir / 'workspace'}")
    elif report["error"]:
        print("error:", report["error"], file=sys.stderr)
    print(f"UI: {UI_URL}  (run {run_id})")
    return report


def parse_compare_models(text):
    out = []
    for entry in text.split(","):
        entry = entry.strip()
        if not entry:
            continue
        if ":" in entry:
            provider, model = entry.split(":", 1)
        else:
            provider, model = entry, default_model(entry)
        out.append((provider.strip(), model.strip()))
    return out


def compare_models_for(mode):
    """The (provider, model) list for a compare mode.

    meta and claude are presets. custom (and None) reads
    COMPARE_MODELS. Preset env vars are read at call time so a
    shell or .env change takes effect without an edit here.
    """
    if mode == "meta":
        return parse_compare_models(
            os.environ.get("COMPARE_META", COMPARE_META))
    if mode == "claude":
        return parse_compare_models(
            os.environ.get("COMPARE_CLAUDE", COMPARE_CLAUDE))
    if mode in ("custom", None):
        return parse_compare_models(
            os.environ.get("COMPARE_MODELS", COMPARE_MODELS))
    raise ValueError(
        f"unknown compare mode '{mode}' "
        f"(valid: {', '.join(COMPARE_MODES)})")


def mode_label(mode):
    return {"single": "single", "meta": "meta vs meta",
            "claude": "meta vs claude", "custom": "custom"}.get(mode, mode)


def describe_mode(mode):
    if mode == "single":
        return "Mode: single"
    models = ", ".join(f"{provider}/{model}"
                       for provider, model in compare_models_for(mode))
    return f"Mode: {mode_label(mode)} ({models})"


def run_compare(prompt, mode, minimal, timeout, repeat):
    comparison_id = uuid.uuid4().hex[:8]
    models = compare_models_for(mode)
    print(f"Comparing {len(models)} model(s), {repeat} round(s), "
          f"set {comparison_id}")
    for round_no, order in compare_schedule(models, repeat):
        for provider, model in order:
            run_prompt(prompt, provider=provider, model=model,
                       minimal=minimal, timeout=timeout,
                       comparison_id=comparison_id,
                       compare_round=round_no, compare_mode=mode)


def handle_command(line, state):
    """Classify one prompt-loop line. Pure: state is only read.

    Returns {"action", "mode", "text"} where action is "prompt",
    "message", "quit", or "none", and mode is the mode after the
    line. The caller prints text and applies mode.
    """
    mode = state.get("mode", "single")
    text = (line or "").strip()
    if not text:
        return {"action": "none", "mode": mode, "text": ""}
    if text in ("/quit", "/exit", "quit", "exit"):
        return {"action": "quit", "mode": mode, "text": ""}
    if text == "/help":
        return {"action": "message", "mode": mode, "text":
                "Commands: /mode, /mode single|meta|claude|custom, "
                "/help, /quit\n"
                "Modes: single (one run), meta (Meta vs Meta), "
                "claude (Meta vs Claude), custom (COMPARE_MODELS)"}
    if text == "/mode":
        return {"action": "message", "mode": mode,
                "text": describe_mode(mode)}
    if text.startswith("/mode "):
        wanted = text[len("/mode "):].strip()
        if wanted in ("single",) + COMPARE_MODES:
            text_out = describe_mode(wanted)
            if wanted == "claude":
                keys = []
                for m_provider, m_model in compare_models_for("claude"):
                    if m_provider in PAID_PROVIDERS:
                        key = endpoint_key_name(m_model)
                        if key not in keys:
                            keys.append(key)
                for key in keys:
                    text_out += f"\nPaid run: uses {key}"
            return {"action": "message", "mode": wanted,
                    "text": text_out}
        return {"action": "message", "mode": mode,
                "text": f"Unknown mode '{wanted}'. "
                        "Valid modes: single, meta, claude, custom."}
    return {"action": "prompt", "mode": mode, "text": text}


def compare_schedule(models, repeat):
    """One (round, order) pair per round. Even rounds reverse the
    order so neither side always goes first."""
    return [(n, models if n % 2 == 1 else list(reversed(models)))
            for n in range(1, repeat + 1)]


def main():
    parser = argparse.ArgumentParser(prog="run-muse")
    parser.add_argument("prompt", nargs="*", help="prompt text")
    parser.add_argument("--provider", default=DEFAULT_PROVIDER)
    parser.add_argument("--model", default=None)
    parser.add_argument("--minimal", action="store_true",
                        help="controlled context: no reminders, no foreign context")
    parser.add_argument("--timeout", type=int, default=None,
                        help="per-run timeout in seconds (default 1800, "
                             "300 for claude-code and anthropic)")
    parser.add_argument("--compare", nargs="?", const="custom",
                        default=None, metavar="MODE",
                        help="compare mode: meta, claude, or custom "
                             "(COMPARE_MODELS)")
    parser.add_argument("--repeat", type=int, default=None,
                        help="compare rounds, alternating order (default 1)")
    args = parser.parse_args()
    if args.repeat is not None and not args.compare:
        parser.error("--repeat needs --compare")
    # Bare --compare takes the next word as its value. When that word
    # is not a mode name it is the first prompt word, and the mode is
    # custom. An explicit --compare=<mode> must name a real mode.
    mode = args.compare
    prompt_words = list(args.prompt)
    if mode is not None and mode not in COMPARE_MODES:
        if any(a.startswith("--compare=") for a in sys.argv):
            parser.error(f"unknown compare mode '{mode}' "
                         f"(valid: {', '.join(COMPARE_MODES)})")
        prompt_words = [mode] + prompt_words
        mode = "custom"
    args.model = args.model or default_model(args.provider)
    ensure_ui()
    prompt = " ".join(prompt_words).strip()
    repeat = args.repeat if args.repeat is not None else 1
    if mode is not None and repeat < 1:
        parser.error("--repeat must be at least 1")
    if prompt and mode is not None:
        run_compare(prompt, mode, args.minimal, args.timeout, repeat)
        return
    if prompt:
        run_prompt(prompt, provider=args.provider, model=args.model,
                   minimal=args.minimal, timeout=args.timeout)
        return
    state = {"mode": mode or "single"}
    if state["mode"] == "single":
        context = "minimal" if args.minimal else "full"
        print(f"Model: {args.provider}/{args.model} ({context} context). "
              f"Type a prompt, /quit to exit. UI: {UI_URL}")
    else:
        print(f"{describe_mode(state['mode'])}. Type a prompt, "
              f"/mode to switch, /quit to exit. UI: {UI_URL}")
    while True:
        prompt_str = "muse> " if state["mode"] == "single" \
            else f"muse[{state['mode']}]> "
        try:
            line = input(prompt_str)
        except (EOFError, KeyboardInterrupt):
            print()
            break
        result = handle_command(line, state)
        state["mode"] = result["mode"]
        if result["action"] == "quit":
            break
        if result["action"] == "message":
            print(result["text"])
            continue
        if result["action"] != "prompt":
            continue
        try:
            if state["mode"] == "single":
                run_prompt(result["text"], provider=args.provider,
                           model=args.model, minimal=args.minimal,
                           timeout=args.timeout)
            else:
                run_compare(result["text"], state["mode"],
                            args.minimal, args.timeout, repeat)
        except KeyboardInterrupt:
            print("\nInterrupted.")


if __name__ == "__main__":
    main()
