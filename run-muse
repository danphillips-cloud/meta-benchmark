def pricing_for(model, pricing):
    if not pricing:
        return None
    return pricing.get(model) or pricing.get("*")


def compute_cost(model, totals, calls, pricing):
    """(cost_usd, pricing_used) from recorded tokens, or (None, None).

    Prices input and output tokens only. Uses totals when present,
    else sums over calls. A missing or partial token figure gives
    None, never a made up cost.
    """
    pair = pricing_for(model, pricing)
    if pair is None:
        return None, None
    if totals:
        in_tok = totals.get("input_tokens")
        out_tok = totals.get("output_tokens")
    elif calls:
        def summed(key):
            values = [c.get(key) for c in calls]
            if any(v is None for v in values):
                return None
            return sum(values)
        in_tok = summed("input_tokens")
        out_tok = summed("output_tokens")
    else:
        return None, None
    if in_tok is None or out_tok is None:
        return None, None
    cost = (in_tok * pair["input_per_mtok"]
            + out_tok * pair["output_per_mtok"]) / 1000000
    return cost, {"model": model, "input_per_mtok": pair["input_per_mtok"],
                  "output_per_mtok": pair["output_per_mtok"]}


def counted_cost(model, cost_usd, cost_source):
    """The cost figure budgets and displays may use, or None.

    Claude Code prices every model from Anthropic's list, so its
    reported cost for a muse-* model is not a Meta price. The
    page hides that figure. Budgets and the terminal must apply
    the same rule, or the three views of one run disagree. A
    computed cost uses the user's own rates and always counts.
    A list cost is Meta's published list and also counts.
    """
    if cost_usd is None:
        return None
    if str(model or "").startswith("muse-") \
            and cost_source not in ("computed", "list"):
        return None
    return cost_usd


def _capture_allowance_start(runner=None):
    """Allowance snapshot from `muse usage --json`, or None.

    A free local query with no model turn. Any failure (no
    binary, bad output, timeout) gives None and the run carries
    on with a dash. Never raises. The runner is injectable so
    tests never execute anything.
    """
    run = runner or subprocess.run
    try:
        proc = run(["muse", "usage", "--json"], capture_output=True,
                   text=True, timeout=15, env=_clean_env())
        if proc.returncode != 0:
            return None
        return list_pricing.allowance_snapshot(json.loads(proc.stdout))
    except Exception:
        return None


def _trim_percent(value):
    if float(value).is_integer():
        value = int(value)
    return str(value)


def _plan_usage_text(report):
    """The "Muse plan: used ..." terminal segment, or "".

    Plain labels from the recorded readings only. The
    short-term limit's length is never stated. It is not
    recorded.
    """
    delta = report.get("allowance_delta") or {}
    start = report.get("allowance_start") or {}
    end = report.get("allowance_end") or {}
    parts = []
    for key, label in (("window", "short-term"), ("weekly", "weekly")):
        moved = delta.get(key)
        if moved is None:
            continue
        # Equal whole-percent readings moved less than one point.
        amount = "under 1%" if moved == 0 else f"{_trim_percent(moved)}%"
        text = f"{amount} of {label} limit"
        before = (start.get(key) or {}).get("used_percent")
        after = (end.get(key) or {}).get("used_percent")
        if before is not None and after is not None:
            text += f" ({_trim_percent(before)}→{_trim_percent(after)}%)"
        parts.append(text)
    if not parts:
        return ""
    return " · Muse plan: used " + ", ".join(parts)


