def start_ui():
    RUNS.mkdir(exist_ok=True)
    log = open(RUNS / "server.log", "ab")
    try:
        subprocess.Popen([sys.executable, str(ROOT / "server.py")],
                         cwd=ROOT, stdout=log, stderr=log,
                         env={**os.environ, "PORT": str(PORT)},
                         start_new_session=True)
    finally:
        log.close()
    for _ in range(20):
        if ui_up():
            break
        time.sleep(0.25)


def _pids_on_port(port):
    if shutil.which("lsof"):
        return subprocess.run(["lsof", "-ti", f"tcp:{port}"],
                              capture_output=True, text=True).stdout.split()
    if shutil.which("ss"):
        out = subprocess.run(["ss", "-tlnp", f"sport = :{port}"],
                             capture_output=True, text=True).stdout
        return sorted(set(re.findall(r"pid=(\d+)", out)))
    if shutil.which("fuser"):
        out = subprocess.run(["fuser", f"{port}/tcp"],
                             capture_output=True, text=True).stdout
        return [p for p in out.replace(",", " ").split() if p.isdigit()]
    return []


def _pid_cmdline(pid):
    proc = Path(f"/proc/{pid}/cmdline")
    if proc.is_file():
        return proc.read_bytes().replace(b"\0", b" ").decode(errors="replace")
    return subprocess.run(["ps", "-p", pid, "-o", "command="],
                          capture_output=True, text=True).stdout


def _pid_cwd(pid):
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        pass
    if shutil.which("lsof"):
        cwd_out = subprocess.run(["lsof", "-a", "-p", pid, "-d", "cwd", "-Fn"],
                                 capture_output=True, text=True).stdout
        return next((l[1:] for l in cwd_out.splitlines() if l.startswith("n")), "")
    return ""


# Set when another app holds PORT, so no UI line points at it.
_ui_blocked = False


def ui_enabled():
    return not os.environ.get("RUN_MUSE_NO_UI") and not _ui_blocked


def _block_ui():
    global _ui_blocked
    _ui_blocked = True
    print(_port_in_use_message(), file=sys.stderr)


def restart_ui():
    for pid in _pids_on_port(PORT):
        cmdline = _pid_cmdline(pid)
        cwd = _pid_cwd(pid)
        is_ours = "server.py" in cmdline and (
            str(ROOT) in cmdline or cwd == str(ROOT))
        if is_ours:
            subprocess.run(["kill", pid], capture_output=True)
        else:
            # A process we did not start is never signalled. Name the
            # clash and leave it alone.
            _block_ui()
            return
    for _ in range(20):
        if not ui_up():
            break
        time.sleep(0.25)
    start_ui()


def ensure_ui():
    if os.environ.get("RUN_MUSE_NO_UI"):
        return
    logs = fetch_ui_logs()
    opened = False
    if logs is None:
        # No answer from our server. If something else is listening on
        # the port, it is not ours to start over or open a tab on.
        if _port_accepts():
            _block_ui()
            return
        start_ui()
        opened = True
    elif logs.get("version") != ui_version():
        print("Updating the log UI to the current version…")
        restart_ui()
        opened = True
    # Only open a tab when we actually started or updated the server.
    # If the page is already up, the user already has it in a tab.
    opened = opened and ui_enabled()
    if opened and sys.platform == "darwin":
        subprocess.run(["open", UI_URL], capture_output=True)
    elif opened and sys.platform.startswith("linux") and shutil.which("xdg-open"):
        subprocess.run(["xdg-open", UI_URL], capture_output=True)


def run_process(cmd, cwd, env, stdout_path, timeout, input_text=None,
                watch=None, stop_event=None, lines_out=None):
    """Run one harness process, writing stdout to stdout_path and
    stderr to the sibling stderr.log. Returns exit state plus the
    stdout lines stamped with arrival time in ms since start.

    `watch`, when given, is polled while the process runs. It may
    return ("needs_approval", tool) to stop the process at once;
    the result then carries needs_approval=tool. `stop_event`, when
    set by another thread, stops the process the same way Ctrl+C
    does. Race legs stop through it, since SIGINT lands only on
    the main thread. `lines_out`, when given, is the list the
    reader appends stamped lines to, so a watch can follow exact
    arrivals as they land instead of re-reading the output file.
    """
    started = time.monotonic()
    lines = lines_out if lines_out is not None else []
    timed_out = False
    interrupted = False
    needs_approval = None
    with open(stdout_path, "w") as out, \
            open(stdout_path.with_name("stderr.log"), "w") as err:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=err,
                                stdin=subprocess.PIPE if input_text is not None else None,
                                env=env, cwd=cwd, start_new_session=True,
                                text=True, errors="replace")

        def reader():
            for line in proc.stdout:
                lines.append((round((time.monotonic() - started) * 1000), line))
                out.write(line)
                out.flush()

        def writer():
            try:
                proc.stdin.write(input_text)
                proc.stdin.close()
            except (BrokenPipeError, OSError):
                pass

        read_thread = threading.Thread(target=reader, daemon=True)
        read_thread.start()
        if input_text is not None:
            threading.Thread(target=writer, daemon=True).start()

        def stop_proc():
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            try:
                return proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                return proc.wait()

        try:
            deadline = started + timeout if timeout is not None else None
            while True:
                try:
                    exit_code = proc.wait(timeout=0.25)
                    break
                except subprocess.TimeoutExpired:
                    pass
                if watch is not None:
                    verdict = watch()
                    if verdict and verdict[0] == "needs_approval":
                        needs_approval = verdict[1]
                        exit_code = stop_proc()
                        break
                if stop_event is not None and stop_event.is_set():
                    interrupted = True
                    exit_code = stop_proc()
                    break
                if deadline is not None and time.monotonic() >= deadline:
                    timed_out = True
                    exit_code = stop_proc()
                    break
            wall_ms = round((time.monotonic() - started) * 1000)
        except KeyboardInterrupt:
            interrupted = True
            exit_code = stop_proc()
            wall_ms = round((time.monotonic() - started) * 1000)
        read_thread.join(timeout=5)
    return {
        "wall_ms": wall_ms,
        "exit_code": exit_code, "timed_out": timed_out,
        "interrupted": interrupted, "lines": lines,
        "needs_approval": needs_approval,
    }


def format_call_line(n, call):
    dur = call.get("duration_ms")
    secs = f"{dur / 1000:.1f} s" if dur is not None else "–"
    inp = call.get("input_tokens")
    tok = f"{round(inp / 1000)}k in" if inp is not None else "– in"
    retries = call.get("retries") or 0
    stalled = call.get("stalled_ms")
    if retries and stalled is not None:
        word = "retry" if retries == 1 else "retries"
        return (f"call {n} · {secs} ({round(stalled / 1000)} s stalled, "
                f"{retries} {word}) · {tok}")
    return f"call {n} · {secs} · {tok}"


def format_live_line(state):
    tool = state.get("tool")
    if state.get("state") == "retrying connection":
        attempt = state.get("attempt")
        return f"retrying connection (attempt {attempt})" if attempt \
            else "retrying connection"
    if state.get("state") == "waiting for approval":
        return f"waiting for approval: {tool}" if tool \
            else "waiting for approval"
    if state.get("state") == "tool running":
        return f"tool running: {tool}" if tool else "tool running"
    return state.get("state") or "idle"


def _live_watch(session_id, seen, label=None):
    """Poll closure for run_process: print finished calls and the
    live state, and stop the run if an approval prompt appears.

    With a label (race legs), every line is prefixed with the leg
    and the live state prints as whole lines. One terminal cannot
    hold several carriage-return lines at once.
    """
    # The log path is resolved once, on the first poll that finds it,
    # and reused from `seen` after that instead of globbing the whole
    # sessions tree on every poll.
    path = seen.get("path")
    if path is None:
        path = muse_log.session_log_path(session_id)
        if not path:
            return None
        seen["path"] = path
    prefix = f"{label} · " if label else ""
    records = muse_log.read_records(path)
    calls = muse_log.calls_from_records(records)
    while seen["calls"] < len(calls):
        seen["calls"] += 1
        with _PRINT_LOCK:
            print(prefix + format_call_line(
                seen["calls"], calls[seen["calls"] - 1]), flush=True)
    state = muse_log.live_state(records)
    if state["state"] == "waiting for approval":
        return ("needs_approval", state.get("tool"))
    text = format_live_line(state)
    if text != seen.get("live"):
        seen["live"] = text
        with _PRINT_LOCK:
            if label or not sys.stdout.isatty():
                print(prefix + text, flush=True)
            else:
                print("\r" + text + "   ", end="", flush=True)
    return None


def format_claude_call_line(n, gap_ms, input_tokens):
    """One landed Claude call, timed by arrival and labelled so.

    gap_ms is time since the previous stream event arrived, by
    the reader thread's own stamp. Claude Code reports no
    per-call duration, so the line says "arrived". It never
    claims model time.
    """
    gap = f"+{gap_ms / 1000:.1f} s" if gap_ms is not None else "–"
    tok = f"{round(input_tokens / 1000)}k in" \
        if input_tokens is not None else "– in"
    return f"call {n} · arrived {gap} · {tok}"


def _claude_live_watch(stamped, seen, label=None):
    """Poll closure for run_process on Claude Code runs.

    stamped is the very list the reader thread appends to, so
    arrival stamps are exact and nothing re-reads the events
    file. Events go through the shared tracker in
    claude_stream, the same one the parser and the server
    use. Prints one whole line per landed call and keeps the
    live state line current, exactly like _live_watch does
    for Muse runs. Always returns None. Claude Code in
    dontAsk mode has no approval wait to stop on.
    """
    prefix = f"{label} · " if label else ""
    tracker = seen["tracker"]
    while seen["index"] < len(stamped):
        arrival, line = stamped[seen["index"]]
        seen["index"] += 1
        try:
            e = json.loads(line)
        except Exception:
            continue
        gap_ms = None
        if arrival is not None:
            last = seen.get("last_arrival")
            gap_ms = arrival - last if last is not None else arrival
            seen["last_arrival"] = arrival
        call = feed_live_event(tracker, e)
        if call is not None:
            with _PRINT_LOCK:
                print(prefix + format_claude_call_line(
                    len(tracker["calls"]), gap_ms,
                    call["input_tokens"]), flush=True)
        text_out = format_live_line(tracker_live_state(tracker))
        if text_out != seen.get("live"):
            seen["live"] = text_out
            with _PRINT_LOCK:
                if label or not sys.stdout.isatty():
                    print(prefix + text_out, flush=True)
                else:
                    print("\r" + text_out + "   ", end="", flush=True)
    return None


def run_muse_exec(prompt, run_dir, provider, model, minimal, timeout,
                  session_id=None, stop_event=None, leg_label=None):
    """Run one prompt through Muse. Returns report fields."""
    session_id = session_id or str(uuid.uuid4())
    workspace = run_dir / "workspace"
    workspace.mkdir()
    (run_dir / "prompt.md").write_text(prompt)
    env = _clean_env()
    cmd = ["muse", "exec", "--json", "--provider", provider,
           "--prompt-file", str(run_dir / "prompt.md"),
           "--workspace", str(workspace),
           "--session-id", session_id,
           "--approval-mode", "never"]
    if provider != "echo":
        cmd += ["--model", model]
    if minimal:
        cmd += ["--disable-reminders", "--no-foreign-personal-context"]
    seen = {"calls": 0, "live": None}
    watch = (lambda: _live_watch(session_id, seen, label=leg_label)) \
        if provider != "echo" else None
    proc = run_process(cmd, workspace, env, run_dir / "events.jsonl",
                       timeout, watch=watch, stop_event=stop_event)
    if sys.stdout.isatty() and not leg_label:
        print(flush=True)
    wall_ms = proc["wall_ms"]
    exit_code = proc["exit_code"]
    timed_out = proc["timed_out"]
    interrupted = proc["interrupted"]
    reply, usage_model, allowance_end = "", None, None
    for line in (run_dir / "events.jsonl").read_text(errors="replace").splitlines():
        try:
            e = json.loads(line)
        except Exception:
            continue
        payload = e.get("payload") or {}
        if payload.get("kind") == "run_terminal":
            reply = payload.get("text") or reply
        if payload.get("kind") == "run_usage":
            models = payload.get("models") or []
            if models and models[0].get("model"):
                usage_model = models[0]["model"]
            snapshot = list_pricing.allowance_snapshot(
                payload.get("allowance"))
            if snapshot is not None:
                allowance_end = snapshot
    # Read the log once even after a timeout or Ctrl+C, so finished calls
    # are kept. Only wait for a late flush when the run exited cleanly.
    calls = harvest_calls(session_id) if provider != "echo" else []
    if not calls and provider != "echo" and exit_code == 0:
        for _ in range(10):
            time.sleep(0.5)
            calls = harvest_calls(session_id)
            if calls:
                break
    return {
        "session_id": session_id, "wall_ms": wall_ms,
        "exit_code": exit_code, "timed_out": timed_out,
        "interrupted": interrupted, "reply": reply,
        "calls": calls, "timeline": build_timeline(session_id, wall_ms),
        "command": " ".join(cmd), "usage_model": usage_model,
        "needs_approval": proc.get("needs_approval"),
        "allowance_end": allowance_end,
    }


def run_anthropic(prompt, run_dir, model, timeout):
    """One direct Anthropic Messages API call. No agent context."""
    base, api_key = endpoint_for(model)
    if not api_key:
        return _empty_result(
            f"POST {base}/v1/messages",
            error=f"{endpoint_key_name(model)} is not set")
    max_tokens = int(os.environ.get("ANTHROPIC_MAX_TOKENS", "8192"))
    body = json.dumps({"model": model, "max_tokens": max_tokens,
                       "messages": [{"role": "user", "content": prompt}]}).encode()
    req = urllib.request.Request(base + "/v1/messages", data=body, method="POST",
        headers={"Content-Type": "application/json", "x-api-key": api_key,
                 "anthropic-version": "2023-06-01"})
    started = time.monotonic()
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.loads(resp.read().decode())
        exit_code, error = 0, None
    except urllib.error.HTTPError as e:
        data, exit_code = {}, e.code
        try:
            error = (json.loads(e.read().decode()).get("error") or {}).get("message")
        except Exception:
            error = f"HTTP {e.code}"
    except Exception as e:
        data, exit_code, error = {}, 1, str(e)
    wall_ms = round((time.monotonic() - started) * 1000)
    usage = data.get("usage") or {}
    reply = "".join(b.get("text", "") for b in (data.get("content") or [])
                    if b.get("type") == "text")
    calls = [{"model": data.get("model") or model, "duration_ms": wall_ms,
              "input_tokens": usage.get("input_tokens"),
              "output_tokens": usage.get("output_tokens"),
              "cached_tokens": usage.get("cache_read_input_tokens"),
              "reasoning_tokens": None,
              "stop_reason": data.get("stop_reason")}] if data else []
    timeline = [{"at": datetime.now(timezone.utc).isoformat(),
                 "operation": "model_completed", "duration_ms": 0,
                 "wire_ms": wall_ms}] if data else []
    (run_dir / "events.jsonl").write_text("")
    (run_dir / "stderr.log").write_text(error or "")
    return {"session_id": None, "wall_ms": wall_ms, "exit_code": exit_code,
            "timed_out": False, "interrupted": False, "reply": reply, "calls": calls,
            "timeline": timeline, "command": f"POST {base}/v1/messages",
            "usage_model": data.get("model"), "error_override": error}


def run_claude_code(prompt, run_dir, model, timeout, stop_event=None,
                    leg_label=None):
    """Run one prompt through Claude Code in --bare mode."""
    workspace = run_dir / "workspace"
    workspace.mkdir()
    (run_dir / "prompt.md").write_text(prompt)
    # Bare mode defaults to auto, which asks the session model to
    # classify each Bash call. muse-wonder-1.0 cannot do that, so
    # every Bash call is denied as "Classifier unavailable".
    # --allowedTools alone does not skip the classifier. dontAsk
    # never consults it: the three tools bare mode exposes run,
    # anything else is denied.
    cmd = ["claude", "-p", "--bare", "--output-format", "stream-json",
           "--verbose", "--model", model,
           "--permission-mode", "dontAsk",
           "--allowedTools", "Bash,Edit,Read"]
    base, api_key = endpoint_for(model)
    if not api_key:
        return _empty_result(
            " ".join(cmd),
            error=f"{endpoint_key_name(model)} is not set")
    env = _clean_env()
    env["ANTHROPIC_API_KEY"] = api_key
    env["ANTHROPIC_BASE_URL"] = base
    env["ANTHROPIC_DEFAULT_HAIKU_MODEL"] = model
    env["ANTHROPIC_DEFAULT_SONNET_MODEL"] = model
    env["ANTHROPIC_DEFAULT_OPUS_MODEL"] = model
    stamped = []
    seen = {"index": 0, "tracker": new_live_tracker(),
            "live": None, "last_arrival": None}
    watch = lambda: _claude_live_watch(  # noqa: E731
        stamped, seen, label=leg_label)
    try:
        proc = run_process(cmd, workspace, env, run_dir / "events.jsonl",
                           timeout, input_text=prompt,
                           stop_event=stop_event, watch=watch,
                           lines_out=stamped)
    except OSError as e:
        return _empty_result(" ".join(cmd), error=str(e))
    watch()
    if sys.stdout.isatty() and not leg_label \
            and seen.get("live") is not None:
        print(flush=True)
    parsed = parse_claude_stream(proc["lines"])
    exit_code = proc["exit_code"]
    error = None
    if parsed["is_error"]:
        if exit_code == 0:
            exit_code = 1
        error = parsed["reply"] or (
            f"api_error_status {parsed['api_error_status']}"
            if parsed["api_error_status"] else "Claude Code reported an error")
    return {
        "session_id": parsed["session_id"], "wall_ms": proc["wall_ms"],
        "exit_code": exit_code, "timed_out": proc["timed_out"],
        "interrupted": proc["interrupted"], "reply": parsed["reply"],
        "calls": parsed["calls"], "timeline": parsed["timeline"],
        "command": " ".join(cmd), "usage_model": parsed["usage_model"],
        "error_override": error, "api_ms": parsed["api_ms"],
        "ttft_ms": parsed["ttft_ms"], "num_turns": parsed["num_turns"],
        "cost_usd": parsed["cost_usd"], "totals": parsed["totals"],
    }


