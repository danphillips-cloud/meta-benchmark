#!/usr/bin/env python3
"""One-command meta-benchmark launcher.

Usage:
  ./run-muse                     interactive prompt loop
  ./run-muse "Say hi"            single prompt run
  ./run-muse --compare meta "Say hi"  same prompt across a mode's models
  ./run-muse --minimal "Say hi"  repeatable context

Starts the log UI in the background if needed, runs each prompt, and
appends the result to muse-runs/ for the UI to display. Meta runs use
the Muse subscription login. Direct API providers use their own key.
"""
import argparse
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
import uuid
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))
import muse_log  # noqa: E402
from muse_log import build_timeline, harvest_calls  # noqa: E402

ROOT = Path(__file__).parent


def load_dotenv(path=None):
    """Load KEY=VALUE lines from the repo-root .env into os.environ.

    Blank lines and # comments are skipped, surrounding quotes are
    stripped, and a variable already set in the environment wins.
    Values are never printed or logged.
    """
    path = path if path is not None else ROOT / ".env"
    if not Path(path).is_file():
        return
    for line in Path(path).read_text(errors="replace").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        if key:
            os.environ.setdefault(key, value)


load_dotenv()
RUNS = ROOT / "muse-runs"
PORT = int(os.environ.get("PORT", "8765"))
UI_URL = f"http://127.0.0.1:{PORT}/"
DEFAULT_MODEL = os.environ.get("MUSE_MODEL", "muse-wonder-full-1.0")
DEFAULT_CLAUDE_MODEL = os.environ.get("BENCH_CLAUDE_MODEL", "claude-sonnet-5-5")
DEFAULT_PROVIDER = os.environ.get("MUSE_PROVIDER", "meta")
STRIP_ENV = ("META_API_KEY", "MUSE_API_TOKEN", "MODEL_API_KEY", "ANTHROPIC_API_KEY")
# provider:model entries used by --compare
COMPARE_MODELS = os.environ.get(
    "COMPARE_MODELS",
    "meta:muse-wonder-1.0,claude-code:muse-wonder-1.0,"
    "claude-code:claude-sonnet-5-5")
COMPARE_META = os.environ.get(
    "COMPARE_META", "meta:muse-wonder-full-1.0,meta:muse-wonder-1.0")
COMPARE_CLAUDE = os.environ.get(
    "COMPARE_CLAUDE",
    "claude-code:muse-wonder-1.0,claude-code:claude-sonnet-5-5")
COMPARE_MODES = ("meta", "claude", "custom")


def default_model(provider):
    # Not ANTHROPIC_MODEL: Meta's Claude Code setup tells users to
    # export that name for a Meta model, which must not silently
    # change this tool's Claude default.
    if provider in ("anthropic", "claude-code"):
        return os.environ.get("BENCH_CLAUDE_MODEL", DEFAULT_CLAUDE_MODEL)
    return os.environ.get("MUSE_MODEL", DEFAULT_MODEL)


def endpoint_for(model):
    """The model id picks the endpoint. muse-* goes to Meta's
    Anthropic-compatible API, anything else goes to Anthropic."""
    if model and model.startswith("muse-"):
        return (os.environ.get("META_BASE_URL",
                               "https://api.meta.ai").rstrip("/"),
                os.environ.get("MODEL_API_KEY"))
    return (os.environ.get("ANTHROPIC_BASE_URL",
                           "https://api.anthropic.com").rstrip("/"),
            os.environ.get("ANTHROPIC_API_KEY"))


def endpoint_key_name(model):
    return "MODEL_API_KEY" if model and model.startswith("muse-") \
        else "ANTHROPIC_API_KEY"


_harness_version_cache = {}


def harness_version(provider):
    """Harness version for this provider, read once per process.

    Muse runs use `muse --version`, Claude Code runs use
    `claude --version`, raw API runs store None. A failed version
    command stores None instead of failing the run.
    """
    if provider == "anthropic":
        return None
    if provider in _harness_version_cache:
        return _harness_version_cache[provider]
    cmd = ["claude", "--version"] if provider == "claude-code" \
        else ["muse", "--version"]
    version = None
    try:
        result = subprocess.run(cmd, capture_output=True, text=True,
                                timeout=5)
        if result.returncode == 0:
            text = (result.stdout or "").strip()
            if text:
                version = text.splitlines()[0].strip() or None
    except Exception:
        version = None
    _harness_version_cache[provider] = version
    return version


def is_muse(provider):
    return provider not in ("anthropic", "claude-code")


def recorded_model(provider, model):
    return "echo" if provider == "echo" else model


def _clean_env():
    return {k: v for k, v in os.environ.items() if k not in STRIP_ENV}


def _empty_result(command, error=None, **overrides):
    """The 'nothing ran' result, shared by every early-exit path."""
    result = {"session_id": None, "wall_ms": 0, "exit_code": 1,
              "timed_out": False, "interrupted": False, "reply": "",
              "calls": [], "timeline": [], "command": command,
              "usage_model": None, "error_override": error}
    result.update(overrides)
    return result


PAID_PROVIDERS = ("claude-code", "anthropic")


def default_timeout(provider):
    return 300 if provider in PAID_PROVIDERS else 1800


def paid_notice(model):
    return f"Paid run: uses {endpoint_key_name(model)}"


def ui_version():
    try:
        m = re.search(r"(?m)^VERSION\s*=\s*(\d+)",
                      (ROOT / "server.py").read_text())
        return int(m.group(1)) if m else None
    except Exception:
        return None


def fetch_ui_logs():
    try:
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        with opener.open(UI_URL + "api/logs", timeout=2) as resp:
            return json.loads(resp.read().decode())
    except Exception:
        return None


def ui_up():
    return fetch_ui_logs() is not None


def _port_accepts():
    """True when something accepts a TCP connection on the UI port."""
    try:
        with socket.create_connection(("127.0.0.1", PORT), timeout=0.5):
            return True
    except OSError:
        return False


def _port_in_use_message():
    return (f"Port {PORT} is in use by another app. "
            f"Set PORT to another port, e.g. PORT={PORT + 1} ./run-muse")


def start_ui():
    RUNS.mkdir(exist_ok=True)
    log = open(RUNS / "server.log", "ab")
    try:
        subprocess.Popen([sys.executable, str(ROOT / "server.py")],
                         cwd=ROOT, stdout=log, stderr=log,
                         env={**os.environ, "PORT": str(PORT)},
                         start_new_session=True)
    finally:
        log.close()
    for _ in range(20):
        if ui_up():
            break
        time.sleep(0.25)


def _pids_on_port(port):
    if shutil.which("lsof"):
        return subprocess.run(["lsof", "-ti", f"tcp:{port}"],
                              capture_output=True, text=True).stdout.split()
    if shutil.which("ss"):
        out = subprocess.run(["ss", "-tlnp", f"sport = :{port}"],
                             capture_output=True, text=True).stdout
        return sorted(set(re.findall(r"pid=(\d+)", out)))
    if shutil.which("fuser"):
        out = subprocess.run(["fuser", f"{port}/tcp"],
                             capture_output=True, text=True).stdout
        return [p for p in out.replace(",", " ").split() if p.isdigit()]
    return []


def _pid_cmdline(pid):
    proc = Path(f"/proc/{pid}/cmdline")
    if proc.is_file():
        return proc.read_bytes().replace(b"\0", b" ").decode(errors="replace")
    return subprocess.run(["ps", "-p", pid, "-o", "command="],
                          capture_output=True, text=True).stdout


def _pid_cwd(pid):
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        pass
    if shutil.which("lsof"):
        cwd_out = subprocess.run(["lsof", "-a", "-p", pid, "-d", "cwd", "-Fn"],
                                 capture_output=True, text=True).stdout
        return next((l[1:] for l in cwd_out.splitlines() if l.startswith("n")), "")
    return ""


# Set when another app holds PORT, so no UI line points at it.
_ui_blocked = False


def ui_enabled():
    return not os.environ.get("RUN_MUSE_NO_UI") and not _ui_blocked


def _block_ui():
    global _ui_blocked
    _ui_blocked = True
    print(_port_in_use_message(), file=sys.stderr)


def restart_ui():
    for pid in _pids_on_port(PORT):
        cmdline = _pid_cmdline(pid)
        cwd = _pid_cwd(pid)
        is_ours = "server.py" in cmdline and (
            str(ROOT) in cmdline or cwd == str(ROOT))
        if is_ours:
            subprocess.run(["kill", pid], capture_output=True)
        else:
            # A process we did not start is never signalled. Name the
            # clash and leave it alone.
            _block_ui()
            return
    for _ in range(20):
        if not ui_up():
            break
        time.sleep(0.25)
    start_ui()


def ensure_ui():
    if os.environ.get("RUN_MUSE_NO_UI"):
        return
    logs = fetch_ui_logs()
    opened = False
    if logs is None:
        # No answer from our server. If something else is listening on
        # the port, it is not ours to start over or open a tab on.
        if _port_accepts():
            _block_ui()
            return
        start_ui()
        opened = True
    elif logs.get("version") != ui_version():
        print("Updating the log UI to the current version…")
        restart_ui()
        opened = True
    # Only open a tab when we actually started or updated the server.
    # If the page is already up, the user already has it in a tab.
    opened = opened and ui_enabled()
    if opened and sys.platform == "darwin":
        subprocess.run(["open", UI_URL], capture_output=True)
    elif opened and sys.platform.startswith("linux") and shutil.which("xdg-open"):
        subprocess.run(["xdg-open", UI_URL], capture_output=True)


def run_process(cmd, cwd, env, stdout_path, timeout, input_text=None,
                watch=None):
    """Run one harness process, writing stdout to stdout_path and
    stderr to the sibling stderr.log. Returns exit state plus the
    stdout lines stamped with arrival time in ms since start.

    `watch`, when given, is polled while the process runs. It may
    return ("needs_approval", tool) to stop the process at once;
    the result then carries needs_approval=tool.
    """
    started = time.monotonic()
    lines = []
    timed_out = False
    interrupted = False
    needs_approval = None
    with open(stdout_path, "w") as out, \
            open(stdout_path.with_name("stderr.log"), "w") as err:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=err,
                                stdin=subprocess.PIPE if input_text is not None else None,
                                env=env, cwd=cwd, start_new_session=True,
                                text=True, errors="replace")

        def reader():
            for line in proc.stdout:
                lines.append((round((time.monotonic() - started) * 1000), line))
                out.write(line)
                out.flush()

        def writer():
            try:
                proc.stdin.write(input_text)
                proc.stdin.close()
            except (BrokenPipeError, OSError):
                pass

        read_thread = threading.Thread(target=reader, daemon=True)
        read_thread.start()
        if input_text is not None:
            threading.Thread(target=writer, daemon=True).start()

        def stop_proc():
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            try:
                return proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                return proc.wait()

        try:
            deadline = started + timeout if timeout is not None else None
            while True:
                try:
                    exit_code = proc.wait(timeout=0.25)
                    break
                except subprocess.TimeoutExpired:
                    pass
                if watch is not None:
                    verdict = watch()
                    if verdict and verdict[0] == "needs_approval":
                        needs_approval = verdict[1]
                        exit_code = stop_proc()
                        break
                if deadline is not None and time.monotonic() >= deadline:
                    timed_out = True
                    exit_code = stop_proc()
                    break
            wall_ms = round((time.monotonic() - started) * 1000)
        except KeyboardInterrupt:
            interrupted = True
            exit_code = stop_proc()
            wall_ms = round((time.monotonic() - started) * 1000)
        read_thread.join(timeout=5)
    return {
        "wall_ms": wall_ms,
        "exit_code": exit_code, "timed_out": timed_out,
        "interrupted": interrupted, "lines": lines,
        "needs_approval": needs_approval,
    }


def format_call_line(n, call):
    dur = call.get("duration_ms")
    secs = f"{dur / 1000:.1f} s" if dur is not None else "–"
    inp = call.get("input_tokens")
    tok = f"{round(inp / 1000)}k in" if inp is not None else "– in"
    retries = call.get("retries") or 0
    stalled = call.get("stalled_ms")
    if retries and stalled is not None:
        word = "retry" if retries == 1 else "retries"
        return (f"call {n} · {secs} ({round(stalled / 1000)} s stalled, "
                f"{retries} {word}) · {tok}")
    return f"call {n} · {secs} · {tok}"


def format_live_line(state):
    tool = state.get("tool")
    if state.get("state") == "retrying connection":
        attempt = state.get("attempt")
        return f"retrying connection (attempt {attempt})" if attempt \
            else "retrying connection"
    if state.get("state") == "waiting for approval":
        return f"waiting for approval: {tool}" if tool \
            else "waiting for approval"
    if state.get("state") == "tool running":
        return f"tool running: {tool}" if tool else "tool running"
    return state.get("state") or "idle"


def _live_watch(session_id, seen):
    """Poll closure for run_process: print finished calls and the
    live state, and stop the run if an approval prompt appears."""
    # The log path is resolved once, on the first poll that finds it,
    # and reused from `seen` after that instead of globbing the whole
    # sessions tree on every poll.
    path = seen.get("path")
    if path is None:
        path = muse_log.session_log_path(session_id)
        if not path:
            return None
        seen["path"] = path
    records = muse_log.read_records(path)
    calls = muse_log.calls_from_records(records)
    while seen["calls"] < len(calls):
        seen["calls"] += 1
        print(format_call_line(seen["calls"], calls[seen["calls"] - 1]),
              flush=True)
    state = muse_log.live_state(records)
    if state["state"] == "waiting for approval":
        return ("needs_approval", state.get("tool"))
    text = format_live_line(state)
    if text != seen.get("live"):
        seen["live"] = text
        if sys.stdout.isatty():
            print("\r" + text + "   ", end="", flush=True)
        else:
            print(text, flush=True)
    return None


def run_muse_exec(prompt, run_dir, provider, model, minimal, timeout,
                  session_id=None):
    """Run one prompt through Muse. Returns report fields."""
    session_id = session_id or str(uuid.uuid4())
    workspace = run_dir / "workspace"
    workspace.mkdir()
    (run_dir / "prompt.md").write_text(prompt)
    env = _clean_env()
    cmd = ["muse", "exec", "--json", "--provider", provider,
           "--prompt-file", str(run_dir / "prompt.md"),
           "--workspace", str(workspace),
           "--session-id", session_id,
           "--approval-mode", "never"]
    if provider != "echo":
        cmd += ["--model", model]
    if minimal:
        cmd += ["--disable-reminders", "--no-foreign-personal-context"]
    seen = {"calls": 0, "live": None}
    watch = (lambda: _live_watch(session_id, seen)) \
        if provider != "echo" else None
    proc = run_process(cmd, workspace, env, run_dir / "events.jsonl",
                       timeout, watch=watch)
    if sys.stdout.isatty():
        print(flush=True)
    wall_ms = proc["wall_ms"]
    exit_code = proc["exit_code"]
    timed_out = proc["timed_out"]
    interrupted = proc["interrupted"]
    reply, usage_model = "", None
    for line in (run_dir / "events.jsonl").read_text(errors="replace").splitlines():
        try:
            e = json.loads(line)
        except Exception:
            continue
        payload = e.get("payload") or {}
        if payload.get("kind") == "run_terminal":
            reply = payload.get("text") or reply
        if payload.get("kind") == "run_usage":
            models = payload.get("models") or []
            if models and models[0].get("model"):
                usage_model = models[0]["model"]
    # Read the log once even after a timeout or Ctrl+C, so finished calls
    # are kept. Only wait for a late flush when the run exited cleanly.
    calls = harvest_calls(session_id) if provider != "echo" else []
    if not calls and provider != "echo" and exit_code == 0:
        for _ in range(10):
            time.sleep(0.5)
            calls = harvest_calls(session_id)
            if calls:
                break
    return {
        "session_id": session_id, "wall_ms": wall_ms,
        "exit_code": exit_code, "timed_out": timed_out,
        "interrupted": interrupted, "reply": reply,
        "calls": calls, "timeline": build_timeline(session_id, wall_ms),
        "command": " ".join(cmd), "usage_model": usage_model,
        "needs_approval": proc.get("needs_approval"),
    }


def run_anthropic(prompt, run_dir, model, timeout):
    """One direct Anthropic Messages API call. No agent context."""
    base, api_key = endpoint_for(model)
    if not api_key:
        return _empty_result(
            f"POST {base}/v1/messages",
            error=f"{endpoint_key_name(model)} is not set")
    max_tokens = int(os.environ.get("ANTHROPIC_MAX_TOKENS", "8192"))
    body = json.dumps({"model": model, "max_tokens": max_tokens,
                       "messages": [{"role": "user", "content": prompt}]}).encode()
    req = urllib.request.Request(base + "/v1/messages", data=body, method="POST",
        headers={"Content-Type": "application/json", "x-api-key": api_key,
                 "anthropic-version": "2023-06-01"})
    started = time.monotonic()
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.loads(resp.read().decode())
        exit_code, error = 0, None
    except urllib.error.HTTPError as e:
        data, exit_code = {}, e.code
        try:
            error = (json.loads(e.read().decode()).get("error") or {}).get("message")
        except Exception:
            error = f"HTTP {e.code}"
    except Exception as e:
        data, exit_code, error = {}, 1, str(e)
    wall_ms = round((time.monotonic() - started) * 1000)
    usage = data.get("usage") or {}
    reply = "".join(b.get("text", "") for b in (data.get("content") or [])
                    if b.get("type") == "text")
    calls = [{"model": data.get("model") or model, "duration_ms": wall_ms,
              "input_tokens": usage.get("input_tokens"),
              "output_tokens": usage.get("output_tokens"),
              "cached_tokens": usage.get("cache_read_input_tokens"),
              "reasoning_tokens": None,
              "stop_reason": data.get("stop_reason")}] if data else []
    timeline = [{"at": datetime.now(timezone.utc).isoformat(),
                 "operation": "model_completed", "duration_ms": 0,
                 "wire_ms": wall_ms}] if data else []
    (run_dir / "events.jsonl").write_text("")
    (run_dir / "stderr.log").write_text(error or "")
    return {"session_id": None, "wall_ms": wall_ms, "exit_code": exit_code,
            "timed_out": False, "interrupted": False, "reply": reply, "calls": calls,
            "timeline": timeline, "command": f"POST {base}/v1/messages",
            "usage_model": data.get("model"), "error_override": error}


def _input_with_cache(usage):
    parts = [usage.get("input_tokens"), usage.get("cache_read_input_tokens"),
             usage.get("cache_creation_input_tokens")]
    if all(p is None for p in parts):
        return None
    return sum(p or 0 for p in parts)


def parse_claude_stream(stamped):
    """Map stamped Claude Code stream-json lines onto report fields.

    stamped holds (arrival_ms, line) pairs from run_process. One call
    per unique assistant message.id. Claude Code reports no per-call
    duration, and per-call output counts are partial snapshots, so
    both stay None and output totals come from the result event.
    result.usage.iterations only holds the last call, so it is not used.
    """
    events = []
    for arrival, line in stamped:
        try:
            events.append((arrival, json.loads(line)))
        except Exception:
            continue
    calls, timeline, seen = [], [], set()
    result, session_id, usage_model = None, None, None
    for i, (arrival, e) in enumerate(events):
        session_id = session_id or e.get("session_id")
        etype = e.get("type")
        label = etype or "event"
        if e.get("subtype"):
            label += f" {e['subtype']}"
        nxt = events[i + 1][0] if i + 1 < len(events) else None
        timeline.append({
            "at": e.get("timestamp"), "operation": label,
            "duration_ms": (nxt - arrival) if nxt is not None else 0,
            "wire_ms": None,
        })
        if etype == "assistant":
            msg = e.get("message") or {}
            mid = msg.get("id")
            # Claude Code emits a "<synthetic>" message to carry an error.
            # It is not a model call.
            if msg.get("model") == "<synthetic>" or (mid and mid in seen):
                continue
            if mid:
                seen.add(mid)
            usage = msg.get("usage") or {}
            usage_model = msg.get("model") or usage_model
            # Meta's endpoint sends all-zero per-call usage. A real call
            # always has input, so 0 means not reported.
            input_tokens = _input_with_cache(usage) or None
            calls.append({
                "model": msg.get("model"), "duration_ms": None,
                "input_tokens": input_tokens,
                "output_tokens": None,
                "cached_tokens": usage.get("cache_read_input_tokens")
                                 if input_tokens else None,
                "reasoning_tokens": None,
            })
        elif etype == "result":
            result = e
    parsed = {"session_id": session_id, "reply": "", "calls": calls,
              "timeline": timeline, "usage_model": usage_model,
              "api_ms": None, "ttft_ms": None, "num_turns": None,
              "cost_usd": None, "totals": None, "is_error": False,
              "api_error_status": None}
    if result:
        usage = result.get("usage") or {}
        parsed.update({
            "session_id": result.get("session_id") or session_id,
            "reply": result.get("result") or "",
            "api_ms": result.get("duration_api_ms"),
            "ttft_ms": result.get("ttft_ms"),
            "num_turns": result.get("num_turns"),
            "cost_usd": result.get("total_cost_usd"),
            "is_error": bool(result.get("is_error")),
            "api_error_status": result.get("api_error_status"),
            "totals": {
                "input_tokens": _input_with_cache(usage),
                "output_tokens": usage.get("output_tokens"),
                "cached_tokens": usage.get("cache_read_input_tokens"),
            },
        })
        models = list((result.get("modelUsage") or {}).keys())
        if models and not parsed["usage_model"]:
            parsed["usage_model"] = models[0]
    return parsed


def run_claude_code(prompt, run_dir, model, timeout):
    """Run one prompt through Claude Code in --bare mode."""
    workspace = run_dir / "workspace"
    workspace.mkdir()
    (run_dir / "prompt.md").write_text(prompt)
    # Bare mode defaults to auto, which asks the session model to
    # classify each Bash call. muse-wonder-1.0 cannot do that, so
    # every Bash call is denied as "Classifier unavailable".
    # --allowedTools alone does not skip the classifier. dontAsk
    # never consults it: the three tools bare mode exposes run,
    # anything else is denied.
    cmd = ["claude", "-p", "--bare", "--output-format", "stream-json",
           "--verbose", "--model", model,
           "--permission-mode", "dontAsk",
           "--allowedTools", "Bash,Edit,Read"]
    base, api_key = endpoint_for(model)
    if not api_key:
        return _empty_result(
            " ".join(cmd),
            error=f"{endpoint_key_name(model)} is not set")
    env = _clean_env()
    env["ANTHROPIC_API_KEY"] = api_key
    env["ANTHROPIC_BASE_URL"] = base
    env["ANTHROPIC_DEFAULT_HAIKU_MODEL"] = model
    env["ANTHROPIC_DEFAULT_SONNET_MODEL"] = model
    env["ANTHROPIC_DEFAULT_OPUS_MODEL"] = model
    try:
        proc = run_process(cmd, workspace, env, run_dir / "events.jsonl",
                           timeout, input_text=prompt)
    except OSError as e:
        return _empty_result(" ".join(cmd), error=str(e))
    parsed = parse_claude_stream(proc["lines"])
    exit_code = proc["exit_code"]
    error = None
    if parsed["is_error"]:
        if exit_code == 0:
            exit_code = 1
        error = parsed["reply"] or (
            f"api_error_status {parsed['api_error_status']}"
            if parsed["api_error_status"] else "Claude Code reported an error")
    return {
        "session_id": parsed["session_id"], "wall_ms": proc["wall_ms"],
        "exit_code": exit_code, "timed_out": proc["timed_out"],
        "interrupted": proc["interrupted"], "reply": parsed["reply"],
        "calls": parsed["calls"], "timeline": parsed["timeline"],
        "command": " ".join(cmd), "usage_model": parsed["usage_model"],
        "error_override": error, "api_ms": parsed["api_ms"],
        "ttft_ms": parsed["ttft_ms"], "num_turns": parsed["num_turns"],
        "cost_usd": parsed["cost_usd"], "totals": parsed["totals"],
    }


BASE_REPORT = {
    "at": None, "run_id": None, "prompt": "", "model": None,
    "provider": None, "session_id": None, "context_mode": None,
    "comparison_id": None, "round": None, "compare_mode": None,
    "suite_id": None, "suite_prompt": None,
    "harness_version": None, "tool_ms": None, "approval_ms": None,
    "muse_ms": None, "needs_approval_tool": None, "status": None,
    "timeout_seconds": None, "command": None, "wall_ms": None,
    "exit_code": None, "reply": "", "calls": [], "timeline": [],
    "api_ms": None, "ttft_ms": None, "num_turns": None,
    "cost_usd": None, "totals": None, "metrics_unavailable": False,
    "error": None, "turn_index": None,
}


def new_run_dir():
    RUNS.mkdir(exist_ok=True)
    run_id = datetime.now().strftime("%Y%m%d-%H%M%S") + "-" \
        + uuid.uuid4().hex[:6]
    run_dir = RUNS / run_id
    run_dir.mkdir()
    return run_id, run_dir


def write_run(run_dir, report):
    (run_dir / "report.json").write_text(json.dumps(report, indent=2))
    summary = {k: v for k, v in report.items() if k != "timeline"}
    with open(RUNS / "index.jsonl", "a") as f:
        f.write(json.dumps(summary) + "\n")


def run_status(r):
    if r.get("needs_approval"):
        return "needs_approval"
    if r["timed_out"]:
        return "timeout"
    if r.get("interrupted"):
        return "interrupted"
    if r["exit_code"] != 0:
        return "failed"
    return "completed"


def _ui_suffix():
    """A trailing UI pointer, or nothing when the UI is off."""
    if not ui_enabled():
        return ""
    return f" UI: {UI_URL}"


def print_summary(report, r, run_dir):
    status = report["status"]
    label = f"{report['provider']}/{report['model']}"
    if report["metrics_unavailable"]:
        print(f"[{label}] wall {r['wall_ms']} ms · "
              "model metrics unavailable (no model records in session log)")
    else:
        durations = [c["duration_ms"] for c in r["calls"]
                     if c.get("duration_ms") is not None]
        model_ms = sum(durations) if durations else r.get("api_ms")
        model_text = "–" if model_ms is None else f"{model_ms} ms"
        totals = r.get("totals") or {}
        in_tok = totals.get("input_tokens") if totals else \
            sum(c["input_tokens"] or 0 for c in r["calls"])
        out_tok = totals.get("output_tokens") if totals else \
            sum(c["output_tokens"] or 0 for c in r["calls"])
        print(f"[{label}] wall {r['wall_ms']} ms · model {model_text} · "
              f"in {in_tok} · out {out_tok} · {len(r['calls'])} call(s) · {status}")
    if r["reply"]:
        print(r["reply"][:500])
        if len(r["reply"]) > 500:
            print(f"… (full reply: muse-runs/{report['run_id']}/report.json)")
    if status == "needs_approval":
        print(f"WARNING: stopped. Waiting for approval: "
              f"{r.get('needs_approval')}. The run was stopped at once "
              f"instead of waiting. Partial files are in "
              f"{run_dir / 'workspace'}")
    elif status == "timeout":
        print(f"Timed out after {report['timeout_seconds']} seconds. "
              "That is the run cap, not a crash. Partial files are in "
              f"{run_dir / 'workspace'}")
    elif status == "interrupted":
        print(f"Interrupted. The run was stopped and recorded. "
              f"Partial files are in {run_dir / 'workspace'}")
    elif report["error"]:
        # Stdout is block-buffered when piped and stderr is not, so
        # flush first or "error:" lands above "Paid run:".
        sys.stdout.flush()
        print("error:", report["error"], file=sys.stderr)
    if ui_enabled():
        print(f"UI: {UI_URL}  (run {report['run_id']})")


def run_prompt(prompt, provider=DEFAULT_PROVIDER, model=None,
               minimal=False, timeout=None, comparison_id=None,
               compare_round=None, compare_mode=None,
               suite_id=None, suite_prompt=None):
    model = model or default_model(provider)
    if timeout is None:
        timeout = default_timeout(provider)
    if provider in PAID_PROVIDERS:
        print(paid_notice(model))
    run_id, run_dir = new_run_dir()
    # Register the run immediately so the UI shows it while it runs.
    # The final summary is appended again at the end; the UI keeps the
    # last entry per run_id.
    live_session_id = str(uuid.uuid4()) if is_muse(provider) else None
    context_mode = "bare" if provider == "claude-code" \
        else ("minimal" if minimal else "full")
    version = harness_version(provider)
    running = {
        "at": datetime.now(timezone.utc).isoformat(),
        "run_id": run_id, "prompt": prompt,
        "model": recorded_model(provider, model),
        "provider": provider, "session_id": live_session_id,
        "context_mode": context_mode,
        "comparison_id": comparison_id, "round": compare_round,
        "compare_mode": compare_mode,
        "suite_id": suite_id, "suite_prompt": suite_prompt,
        "harness_version": version,
        "status": "running",
        "timeout_seconds": timeout, "command": None,
        "wall_ms": None, "exit_code": None, "reply": "",
        "calls": [], "metrics_unavailable": False, "error": None,
    }
    with open(RUNS / "index.jsonl", "a") as f:
        f.write(json.dumps(running) + "\n")
    started = time.monotonic()
    try:
        if provider == "anthropic":
            r = run_anthropic(prompt, run_dir, model, timeout)
        elif provider == "claude-code":
            r = run_claude_code(prompt, run_dir, model, timeout)
        else:
            r = run_muse_exec(prompt, run_dir, provider, model, minimal, timeout,
                              session_id=live_session_id)
    except KeyboardInterrupt:
        # Ctrl+C during a direct API call, or outside proc.wait() in
        # run_muse_exec, must still write a final status below.
        r = _empty_result(
            None, session_id=live_session_id,
            wall_ms=round((time.monotonic() - started) * 1000),
            exit_code=130, interrupted=True)
    status = run_status(r)
    stderr_tail = ""
    err_file = run_dir / "stderr.log"
    if err_file.is_file():
        lines = err_file.read_text(errors="replace").strip().splitlines()
        stderr_tail = lines[-1] if lines else ""
    split = {"model_ms": None, "tool_ms": None,
             "approval_ms": None, "muse_ms": None}
    if r.get("session_id") and is_muse(provider):
        log_path = muse_log.session_log_path(r["session_id"])
        if log_path:
            dur = [c["duration_ms"] for c in r["calls"]
                   if c.get("duration_ms") is not None]
            split = muse_log.time_split(
                muse_log.read_records(log_path), r["wall_ms"],
                sum(dur) if dur else None)
    report = dict(BASE_REPORT)
    report.update({
        "at": datetime.now(timezone.utc).isoformat(),
        "run_id": run_id, "prompt": prompt,
        "model": r.get("usage_model") or recorded_model(provider, model),
        "provider": provider, "session_id": r["session_id"],
        "context_mode": context_mode,
        "comparison_id": comparison_id, "round": compare_round,
        "compare_mode": compare_mode,
        "suite_id": suite_id, "suite_prompt": suite_prompt,
        "harness_version": version,
        "tool_ms": split["tool_ms"], "approval_ms": split["approval_ms"],
        "muse_ms": split["muse_ms"],
        "needs_approval_tool": r.get("needs_approval"),
        "status": status, "timeout_seconds": timeout,
        "command": r["command"],
        "wall_ms": r["wall_ms"], "exit_code": r["exit_code"],
        "reply": r["reply"], "calls": r["calls"], "timeline": r["timeline"],
        "api_ms": r.get("api_ms"), "ttft_ms": r.get("ttft_ms"),
        "num_turns": r.get("num_turns"), "cost_usd": r.get("cost_usd"),
        "totals": r.get("totals"),
        "metrics_unavailable": status == "completed" and not r["calls"],
        "error": (f"waiting for approval: {r['needs_approval']}"
                  if r.get("needs_approval") else None)
                 or r.get("error_override")
                 or (stderr_tail if status != "completed" else None),
    })
    write_run(run_dir, report)
    print_summary(report, r, run_dir)
    return report


def _fmt_bucket(ms):
    return "–" if ms is None else f"{ms / 1000:.1f} s"


def record_watch_turn(turn, session_id, provider="muse-watch",
                      command="./run-muse --watch", quiet=False):
    """Append one finished interactive turn as a run."""
    run_id, run_dir = new_run_dir()
    (run_dir / "prompt.md").write_text(turn["prompt"])
    split = turn["split"]
    report = dict(BASE_REPORT)
    report.update({
        "at": turn["at"], "run_id": run_id, "prompt": turn["prompt"],
        "model": turn["model"], "provider": provider,
        "session_id": session_id, "context_mode": "interactive",
        "harness_version": turn["version"],
        "tool_ms": split["tool_ms"],
        "approval_ms": split["approval_ms"],
        "muse_ms": split["muse_ms"],
        "status": "completed",
        "command": command,
        "wall_ms": turn["wall_ms"], "exit_code": 0,
        "calls": turn["calls"], "timeline": turn.get("timeline") or [],
        "turn_index": turn["index"],
    })
    write_run(run_dir, report)
    if quiet:
        return report
    print(f"turn {turn['index']} · wall {_fmt_bucket(turn['wall_ms'])}"
          f" · model {_fmt_bucket(split['model_ms'])}"
          f" · tools {_fmt_bucket(split['tool_ms'])}"
          f" · approval {_fmt_bucket(split['approval_ms'])}"
          f" · Muse {_fmt_bucket(split['muse_ms'])}"
          f" · {len(turn['calls'])} call(s)", flush=True)
    return report


def run_watch(session_arg=None):
    """Attach read-only to a Muse session and record its turns.

    Never starts, stops or answers Muse: the log file is only read.
    Runs until the session ends or Ctrl+C.
    """
    if session_arg:
        path = muse_log.session_log_path(session_arg)
        session_id = session_arg
    else:
        path = muse_log.newest_session_path()
        session_id = path.parent.name if path else None
    if not path or not Path(path).is_file():
        print("No Muse session log found to watch.", file=sys.stderr)
        return
    print(f"Watching session {session_id} read-only. "
          f"Run Muse normally in another terminal; Ctrl+C stops "
          f"watching.{_ui_suffix()}", flush=True)
    recorded = set()
    try:
        while True:
            records = muse_log.read_records(path)
            for turn in muse_log.split_turns(records):
                if turn["index"] not in recorded:
                    recorded.add(turn["index"])
                    record_watch_turn(turn, session_id)
            if any(e.get("payload_type") == "session.end"
                   for e in records):
                print("Session ended.", flush=True)
                return
            time.sleep(1)
    except KeyboardInterrupt:
        # split_turns only returns the trailing turn once the session
        # has ended, so this only catches turns that closed in the
        # last poll second.
        records = muse_log.read_records(path)
        turns = muse_log.split_turns(records)
        for turn in turns:
            if turn["index"] not in recorded:
                recorded.add(turn["index"])
                record_watch_turn(turn, session_id)
        print("\nStopped watching.", flush=True)


_TURN_PROVIDERS = ("muse-watch", "muse-retro")


def _index_entries():
    index = RUNS / "index.jsonl"
    entries = []
    if index.is_file():
        for line in index.read_text(errors="replace").splitlines():
            try:
                entries.append(json.loads(line))
            except Exception:
                continue
    return entries


def retro_plan(entries, sessions):
    """(session_id, turn) pairs still missing from the index.

    A session already recorded by the launcher (any provider other
    than the turn importers) is skipped whole. Its turns are runs
    with launcher-measured walls already. A turn recorded by watch
    or an earlier retro run is skipped by (session_id, turn_index).
    """
    owned = {e.get("session_id") for e in entries
             if e.get("session_id")
             and e.get("provider") not in _TURN_PROVIDERS}
    seen = {(e.get("session_id"), e.get("turn_index")) for e in entries
            if e.get("provider") in _TURN_PROVIDERS
            and e.get("session_id")}
    plan = []
    for session_id, turns in sessions:
        if session_id in owned:
            continue
        for turn in turns:
            if (session_id, turn["index"]) not in seen:
                plan.append((session_id, turn))
    return plan


def run_retro():
    """Record finished turns from every Muse session log on disk.

    Read-only on the logs. Only closed turns import, the same rule
    watch uses, so a session still running contributes nothing in
    flight. Rerunning imports only turns closed since the last run.
    """
    files = sorted(muse_log.sessions_dir().glob("**/session.jsonl"))
    if not files:
        print("No Muse session logs found.", flush=True)
        return
    sessions = []
    seen_ids = set()
    for path in files:
        session_id = path.parent.name
        if session_id in seen_ids:
            continue
        seen_ids.add(session_id)
        records = muse_log.read_records(path)
        turns = muse_log.split_turns(records)
        if not turns:
            continue
        first = min((e.get("recorded_at") or 0) for e in records)
        sessions.append((first, session_id, turns))
    sessions.sort(key=lambda s: (s[0], s[1]))
    plan = retro_plan(_index_entries(),
                      [(sid, turns) for _, sid, turns in sessions])
    planned = {}
    for session_id, _turn in plan:
        planned[session_id] = planned.get(session_id, 0) + 1
    candidates = sum(len(turns) for _, _, turns in sessions)
    for _first, session_id, turns in sessions:
        imported = planned.get(session_id, 0)
        if imported:
            print(f"session {session_id}: imported {imported} turn(s), "
                  f"skipped {len(turns) - imported}", flush=True)
    for session_id, turn in plan:
        record_watch_turn(turn, session_id, provider="muse-retro",
                          command="./run-muse --retro", quiet=True)
    print(f"Retro done. Imported {len(plan)} turn(s) from "
          f"{len(planned)} session(s). Skipped "
          f"{candidates - len(plan)} turn(s) already recorded."
          f"{_ui_suffix()}", flush=True)


def parse_compare_models(text):
    out = []
    for entry in text.split(","):
        entry = entry.strip()
        if not entry:
            continue
        if ":" in entry:
            provider, model = entry.split(":", 1)
        else:
            provider, model = entry, default_model(entry)
        out.append((provider.strip(), model.strip()))
    return out


def compare_models_for(mode):
    """The (provider, model) list for a compare mode.

    meta and claude are presets. custom (and None) reads
    COMPARE_MODELS. Preset env vars are read at call time so a
    shell or .env change takes effect without an edit here.
    """
    if mode == "meta":
        return parse_compare_models(
            os.environ.get("COMPARE_META", COMPARE_META))
    if mode == "claude":
        return parse_compare_models(
            os.environ.get("COMPARE_CLAUDE", COMPARE_CLAUDE))
    if mode in ("custom", None):
        return parse_compare_models(
            os.environ.get("COMPARE_MODELS", COMPARE_MODELS))
    raise ValueError(
        f"unknown compare mode '{mode}' "
        f"(valid: {', '.join(COMPARE_MODES)})")


def mode_label(mode):
    return {"single": "single", "meta": "meta vs meta",
            "claude": "meta vs claude", "custom": "custom"}.get(mode, mode)


def describe_mode(mode):
    if mode == "single":
        return "Mode: single"
    models = ", ".join(f"{provider}/{model}"
                       for provider, model in compare_models_for(mode))
    return f"Mode: {mode_label(mode)} ({models})"


def exit_code_for(status):
    if status == "completed":
        return 0
    if status == "interrupted":
        return 130
    return 1


def run_compare(prompt, mode, minimal, timeout, repeat):
    comparison_id = uuid.uuid4().hex[:8]
    models = compare_models_for(mode)
    print(f"Comparing {len(models)} model(s), {repeat} round(s), "
          f"set {comparison_id}")
    statuses = []
    for round_no, order in compare_schedule(models, repeat):
        for provider, model in order:
            report = run_prompt(prompt, provider=provider, model=model,
                                minimal=minimal, timeout=timeout,
                                comparison_id=comparison_id,
                                compare_round=round_no, compare_mode=mode)
            statuses.append(report["status"])
    done = sum(1 for status in statuses if status == "completed")
    closing = f"Compare set {comparison_id} done: {done} completed of {len(statuses)}."
    if ui_enabled():
        closing += f" UI: {UI_URL}compare/{comparison_id}"
    print(closing)
    if "interrupted" in statuses:
        return 130
    if any(status != "completed" for status in statuses):
        return 1
    return 0


SUITE_DEFAULT = ROOT / "golden-prompts.json"


def load_suite(path):
    """Golden prompts from a JSON file: {\"prompts\": [entry, ...]}.

    Each entry needs a unique non-empty name and prompt. Provider,
    model and minimal are optional per entry. Raises ValueError with
    a plain message for anything else, so main can show it as-is.
    """
    path = Path(path)
    try:
        text = path.read_text()
    except OSError as e:
        raise ValueError(
            f"cannot read suite file {path}: {e.strerror or e}")
    try:
        data = json.loads(text)
    except Exception:
        raise ValueError(f"suite file {path} is not valid JSON")
    raw = data.get("prompts") if isinstance(data, dict) else None
    if not isinstance(raw, list) or not raw:
        raise ValueError("suite file needs a non-empty 'prompts' list")
    entries = []
    seen = set()
    for i, entry in enumerate(raw):
        name = entry.get("name") if isinstance(entry, dict) else None
        prompt = entry.get("prompt") if isinstance(entry, dict) else None
        if not isinstance(name, str) or not name.strip() \
                or not isinstance(prompt, str) or not prompt.strip():
            raise ValueError(
                f"suite entry {i + 1} needs non-empty 'name' and "
                "'prompt'")
        if name in seen:
            raise ValueError(f"duplicate suite prompt name '{name}'")
        seen.add(name)
        entries.append({
            "name": name, "prompt": prompt,
            "provider": entry.get("provider") or DEFAULT_PROVIDER,
            "model": entry.get("model"),
            "minimal": bool(entry.get("minimal")),
        })
    return entries


def previous_suite_version(provider):
    """Last harness version a suite run recorded for this provider."""
    index = RUNS / "index.jsonl"
    last = None
    if index.is_file():
        for line in index.read_text(errors="replace").splitlines():
            try:
                entry = json.loads(line)
            except Exception:
                continue
            if entry.get("suite_id") \
                    and entry.get("provider") == provider \
                    and entry.get("harness_version"):
                last = entry["harness_version"]
    return last


def suite_version_notice(previous, current, provider):
    if previous and current and previous != current:
        return (f"Harness changed since the last suite run: "
                f"{provider} was {previous}, now {current}.")
    return None


def run_suite(path, timeout, repeat):
    entries = load_suite(path)
    suite_id = uuid.uuid4().hex[:8]
    print(f"Suite {suite_id}: {len(entries)} prompt(s), "
          f"{repeat} repeat(s) each")
    providers = []
    for entry in entries:
        if entry["provider"] not in providers:
            providers.append(entry["provider"])
    for provider in providers:
        notice = suite_version_notice(
            previous_suite_version(provider),
            harness_version(provider), provider)
        if notice:
            print(notice)
    statuses = []
    stop = False
    for _round in range(repeat):
        for entry in entries:
            if stop:
                break
            try:
                report = run_prompt(
                    entry["prompt"], provider=entry["provider"],
                    model=entry["model"], minimal=entry["minimal"],
                    timeout=timeout, suite_id=suite_id,
                    suite_prompt=entry["name"])
                statuses.append(report["status"])
            except KeyboardInterrupt:
                statuses.append("interrupted")
                stop = True
        if stop:
            break
    done = sum(1 for status in statuses if status == "completed")
    closing = f"Suite {suite_id} done: {done} completed of {len(statuses)}."
    if ui_enabled():
        closing += f" UI: {UI_URL}radar"
    print(closing)
    if "interrupted" in statuses:
        return 130
    if any(status != "completed" for status in statuses):
        return 1
    return 0


def handle_command(line, state):
    """Classify one prompt-loop line. Pure: state is only read.

    Returns {"action", "mode", "text"} where action is "prompt",
    "message", "quit", or "none", and mode is the mode after the
    line. The caller prints text and applies mode.
    """
    mode = state.get("mode", "single")
    text = (line or "").strip()
    if not text:
        return {"action": "none", "mode": mode, "text": ""}
    if text in ("/quit", "/exit", "quit", "exit"):
        return {"action": "quit", "mode": mode, "text": ""}
    if text == "/help":
        return {"action": "message", "mode": mode, "text":
                "Commands: /mode, /mode single|meta|claude|custom, "
                "/help, /quit\n"
                "Modes: single (one run), meta (Meta vs Meta), "
                "claude (Meta vs Claude), custom (COMPARE_MODELS)\n"
                "Ctrl+C stops a run and records it as interrupted."}
    if text == "/mode":
        return {"action": "message", "mode": mode,
                "text": describe_mode(mode)}
    if text.startswith("/mode "):
        wanted = text[len("/mode "):].strip()
        if wanted in ("single",) + COMPARE_MODES:
            text_out = describe_mode(wanted)
            if wanted == "claude":
                notices = []
                for m_provider, m_model in compare_models_for("claude"):
                    if m_provider in PAID_PROVIDERS:
                        notice = paid_notice(m_model)
                        if notice not in notices:
                            notices.append(notice)
                for notice in notices:
                    text_out += "\n" + notice
            return {"action": "message", "mode": wanted,
                    "text": text_out}
        return {"action": "message", "mode": mode,
                "text": f"Unknown mode '{wanted}'. "
                        "Valid modes: single, meta, claude, custom."}
    return {"action": "prompt", "mode": mode, "text": text}


def compare_schedule(models, repeat):
    """One (round, order) pair per round. Even rounds reverse the
    order so neither side always goes first."""
    return [(n, models if n % 2 == 1 else list(reversed(models)))
            for n in range(1, repeat + 1)]


def main():
    # A launcher started in the background of a non-interactive shell
    # inherits SIGINT as ignored, so kill -INT would never land.
    signal.signal(signal.SIGINT, signal.default_int_handler)
    parser = argparse.ArgumentParser(prog="run-muse")
    parser.add_argument("prompt", nargs="*", help="prompt text")
    parser.add_argument("--provider", default=DEFAULT_PROVIDER)
    parser.add_argument("--model", default=None)
    parser.add_argument("--minimal", action="store_true",
                        help="repeatable context: no reminders, no foreign context")
    parser.add_argument("--timeout", type=int, default=None,
                        help="per-run timeout in seconds (default 1800, "
                             "300 for claude-code and anthropic)")
    parser.add_argument("--compare", default=None, choices=COMPARE_MODES,
                        help="compare mode: meta, claude, or custom "
                             "(COMPARE_MODELS)")
    parser.add_argument("--repeat", type=int, default=None,
                        help="compare rounds, alternating order (default 1)")
    parser.add_argument("--watch", nargs="?", const="", default=None,
                        metavar="SESSION",
                        help="watch a Muse session read-only (newest "
                             "when no session id is given) and record "
                             "each finished turn")
    parser.add_argument("--retro", action="store_true",
                        help="record finished turns from every Muse "
                             "session log already on disk")
    parser.add_argument("--suite", nargs="?", const=str(SUITE_DEFAULT),
                        default=None, metavar="FILE",
                        help="run the golden prompt suite (default file "
                             "golden-prompts.json) and stamp each run "
                             "for the regression radar")
    args = parser.parse_args()
    if args.repeat is not None and not args.compare \
            and args.suite is None:
        parser.error("--repeat needs --compare or --suite")
    if args.suite is not None and (args.prompt or args.compare
                                   or args.watch is not None or args.retro):
        parser.error("--suite takes no prompt, --compare, --watch or --retro")
    if args.watch is not None and (args.prompt or args.compare):
        parser.error("--watch takes no prompt or --compare")
    if args.retro and (args.prompt or args.compare
                       or args.watch is not None):
        parser.error("--retro takes no prompt, --compare or --watch")
    mode = args.compare
    args.model = args.model or default_model(args.provider)
    repeat = args.repeat if args.repeat is not None else 1
    if (mode is not None or args.suite is not None) and repeat < 1:
        parser.error("--repeat must be at least 1")
    if args.suite is not None:
        suite_repeat = args.repeat if args.repeat is not None else 3
        try:
            load_suite(args.suite)
        except ValueError as e:
            parser.error(str(e))
        ensure_ui()
        return run_suite(args.suite, args.timeout, suite_repeat)
    ensure_ui()
    if args.watch is not None:
        run_watch(args.watch or None)
        return 0
    if args.retro:
        run_retro()
        return 0
    prompt = " ".join(args.prompt).strip()
    if prompt and mode is not None:
        return run_compare(prompt, mode, args.minimal, args.timeout, repeat)
    if prompt:
        report = run_prompt(prompt, provider=args.provider,
                            model=args.model, minimal=args.minimal,
                            timeout=args.timeout)
        return exit_code_for(report["status"])
    state = {"mode": mode or "single"}
    if state["mode"] == "single":
        context = "minimal" if args.minimal else "full"
        print(f"Model: {args.provider}/{args.model} ({context} context). "
              f"Type a prompt, /quit to exit.{_ui_suffix()}")
    else:
        print(f"{describe_mode(state['mode'])}. Type a prompt, "
              f"/mode to switch, /quit to exit.{_ui_suffix()}")
    while True:
        prompt_str = "muse> " if state["mode"] == "single" \
            else f"muse[{state['mode']}]> "
        try:
            line = input(prompt_str)
        except (EOFError, KeyboardInterrupt):
            print()
            break
        result = handle_command(line, state)
        state["mode"] = result["mode"]
        if result["action"] == "quit":
            break
        if result["action"] == "message":
            print(result["text"])
            continue
        if result["action"] != "prompt":
            continue
        try:
            if state["mode"] == "single":
                run_prompt(result["text"], provider=args.provider,
                           model=args.model, minimal=args.minimal,
                           timeout=args.timeout)
            else:
                run_compare(result["text"], state["mode"],
                            args.minimal, args.timeout, repeat)
        except KeyboardInterrupt:
            print("\nInterrupted.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
