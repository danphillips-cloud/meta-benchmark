_harness_version_cache = {}


def harness_version(provider):
    """Harness version for this provider, read once per process.

    Muse runs use `muse --version`, Claude Code runs use
    `claude --version`, raw API runs store None. A failed version
    command stores None instead of failing the run.
    """
    if provider == "anthropic":
        return None
    if provider in _harness_version_cache:
        return _harness_version_cache[provider]
    cmd = ["claude", "--version"] if provider == "claude-code" \
        else ["muse", "--version"]
    version = None
    try:
        result = subprocess.run(cmd, capture_output=True, text=True,
                                timeout=5)
        if result.returncode == 0:
            text = (result.stdout or "").strip()
            if text:
                version = text.splitlines()[0].strip() or None
    except Exception:
        version = None
    _harness_version_cache[provider] = version
    return version


