def load_dotenv(path=None):
    """Load KEY=VALUE lines from the repo-root .env into os.environ.

    Blank lines and # comments are skipped, surrounding quotes are
    stripped, and a variable already set in the environment wins.
    Values are never printed or logged.
    """
    path = path if path is not None else ROOT / ".env"
    if not Path(path).is_file():
        return
    for line in Path(path).read_text(errors="replace").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        if key:
            os.environ.setdefault(key, value)


