def new_run_dir():
    RUNS.mkdir(exist_ok=True)
    while True:
        run_id = datetime.now().strftime("%Y%m%d-%H%M%S") + "-" \
            + uuid.uuid4().hex[:6]
        run_dir = RUNS / run_id
        try:
            run_dir.mkdir()
            return run_id, run_dir
        except FileExistsError:
            continue


def write_run(run_dir, report):
    (run_dir / "report.json").write_text(json.dumps(report, indent=2))
    summary = {k: v for k, v in report.items() if k != "timeline"}
    with _INDEX_LOCK, _index_file_lock(RUNS / "index.jsonl"), \
            open(RUNS / "index.jsonl", "a") as f:
        f.write(json.dumps(summary) + "\n")


def run_status(r):
    if r.get("needs_approval"):
        return "needs_approval"
    if r["timed_out"]:
        return "timeout"
    if r.get("interrupted"):
        return "interrupted"
    if r["exit_code"] != 0:
        return "failed"
    return "completed"


def _ui_suffix():
    """A trailing UI pointer, or nothing when the UI is off."""
    if not ui_enabled():
        return ""
    return f" UI: {UI_URL}"


def print_summary(report, r, run_dir):
    status = report["status"]
    label = f"{report['provider']}/{report['model']}"
    allow_text = _plan_usage_text(report)
    if report["metrics_unavailable"]:
        print(f"[{label}] wall {r['wall_ms']} ms · "
              "model metrics unavailable "
              f"(no model records in session log){allow_text}")
    else:
        # Strict totals: one missing call value makes the total
        # unknown (a dash), never a partial sum.
        durations = [c.get("duration_ms") for c in r["calls"]]
        model_ms = sum(durations) \
            if durations and all(d is not None for d in durations) \
            else r.get("api_ms")
        model_text = "–" if model_ms is None else f"{model_ms} ms"
        totals = r.get("totals") or {}

        def summed(key):
            values = [c.get(key) for c in r["calls"]]
            if not values or any(v is None for v in values):
                return None
            return sum(values)

        in_tok = totals.get("input_tokens") if totals \
            else summed("input_tokens")
        out_tok = totals.get("output_tokens") if totals \
            else summed("output_tokens")
        in_text = "–" if in_tok is None else str(in_tok)
        out_text = "–" if out_tok is None else str(out_tok)
        cost_text = ""
        shown_cost = counted_cost(report.get("model"),
                                  report.get("cost_usd"),
                                  report.get("cost_source"))
        if shown_cost is not None:
            cost_text = f" · cost ${shown_cost:.4f}"
            if report.get("cost_source") == "computed":
                cost_text += " (at your rates)"
            elif report.get("cost_source") == "list":
                cost_text += " (at Meta list)"
        print(f"[{label}] wall {r['wall_ms']} ms · model {model_text} · "
              f"in {in_text} · out {out_text} · {len(r['calls'])} call(s)"
              f"{cost_text}{allow_text} · {status}")
    if r["reply"]:
        print(r["reply"][:500])
        if len(r["reply"]) > 500:
            print(f"… (full reply: muse-runs/{report['run_id']}/report.json)")
    if status == "needs_approval":
        print(f"WARNING: stopped. Waiting for approval: "
              f"{r.get('needs_approval')}. The run was stopped at once "
              f"instead of waiting. Partial files are in "
              f"{run_dir / 'workspace'}")
    elif status == "timeout":
        print(f"Timed out after {report['timeout_seconds']} seconds. "
              "That is the run cap, not a crash. Partial files are in "
              f"{run_dir / 'workspace'}")
    elif status == "interrupted":
        print(f"Interrupted. The run was stopped and recorded. "
              f"Partial files are in {run_dir / 'workspace'}")
    elif report["error"]:
        # Stdout is block-buffered when piped and stderr is not, so
        # flush first or "error:" lands above "Paid run:".
        sys.stdout.flush()
        print("error:", report["error"], file=sys.stderr)
    if ui_enabled():
        print(f"UI: {UI_URL}  (run {report['run_id']})")


def run_prompt(prompt, provider=DEFAULT_PROVIDER, model=None,
               minimal=False, timeout=None, comparison_id=None,
               compare_round=None, compare_mode=None,
               suite_id=None, suite_prompt=None,
               raced=False, stop_event=None, pricing=None):
    model = model or default_model(provider)
    if timeout is None:
        timeout = default_timeout(provider)
    if provider in PAID_PROVIDERS:
        with _PRINT_LOCK:
            print(paid_notice(model), flush=True)
    run_id, run_dir = new_run_dir()
    # Register the run immediately so the UI shows it while it runs.
    # The final summary is appended again at the end; the UI keeps the
    # last entry per run_id.
    live_session_id = str(uuid.uuid4()) if is_muse(provider) else None
    context_mode = "bare" if provider == "claude-code" \
        else ("minimal" if minimal else "full")
    version = harness_version(provider)
    # Allowance start snapshot, captured before the running row
    # and before wall timing starts, so the free usage query
    # never inflates the run's wall. Muse paths only.
    allowance_start = _capture_allowance_start() \
        if is_muse(provider) and provider != "echo" else None
    # `at` is always the start time. The final report reuses this
    # instant and records its own finish in `finished_at`.
    started_at = datetime.now(timezone.utc).isoformat()
    running = {
        "at": started_at,
        "allowance_start": allowance_start,
        "run_id": run_id, "prompt": prompt,
        "model": recorded_model(provider, model),
        "provider": provider, "session_id": live_session_id,
        "context_mode": context_mode,
        "comparison_id": comparison_id, "round": compare_round,
        "compare_mode": compare_mode, "raced": raced,
        "suite_id": suite_id, "suite_prompt": suite_prompt,
        "harness_version": version,
        "status": "running",
        "timeout_seconds": timeout, "command": None,
        "wall_ms": None, "exit_code": None, "reply": "",
        "calls": [], "metrics_unavailable": False, "error": None,
    }
    with _INDEX_LOCK, _index_file_lock(RUNS / "index.jsonl"), \
            open(RUNS / "index.jsonl", "a") as f:
        f.write(json.dumps(running) + "\n")
    started = time.monotonic()
    leg_label = f"{provider}/{recorded_model(provider, model)}" \
        if raced else None
    try:
        if provider == "anthropic":
            r = run_anthropic(prompt, run_dir, model, timeout)
        elif provider == "claude-code":
            r = run_claude_code(prompt, run_dir, model, timeout,
                                stop_event=stop_event,
                                leg_label=leg_label)
        else:
            r = run_muse_exec(prompt, run_dir, provider, model, minimal, timeout,
                              session_id=live_session_id,
                              stop_event=stop_event, leg_label=leg_label)
    except KeyboardInterrupt:
        # Ctrl+C during a direct API call, or outside proc.wait() in
        # run_muse_exec, must still write a final status below.
        r = _empty_result(
            None, session_id=live_session_id,
            wall_ms=round((time.monotonic() - started) * 1000),
            exit_code=130, interrupted=True)
    status = run_status(r)
    stderr_tail = ""
    err_file = run_dir / "stderr.log"
    if err_file.is_file():
        lines = err_file.read_text(errors="replace").strip().splitlines()
        stderr_tail = lines[-1] if lines else ""
    split = {"model_ms": None, "tool_ms": None,
             "approval_ms": None, "muse_ms": None}
    if r.get("session_id") and is_muse(provider):
        log_path = muse_log.session_log_path(r["session_id"])
        if log_path:
            dur = [c.get("duration_ms") for c in r["calls"]]
            split = muse_log.time_split(
                muse_log.read_records(log_path), r["wall_ms"],
                sum(dur) if dur and all(d is not None for d in dur)
                else None)
    report = dict(BASE_REPORT)
    report.update({
        "at": started_at,
        "finished_at": datetime.now(timezone.utc).isoformat(),
        "run_id": run_id, "prompt": prompt,
        "model": r.get("usage_model") or recorded_model(provider, model),
        "provider": provider, "session_id": r["session_id"],
        "context_mode": context_mode,
        "comparison_id": comparison_id, "round": compare_round,
        "compare_mode": compare_mode, "raced": raced,
        "suite_id": suite_id, "suite_prompt": suite_prompt,
        "harness_version": version,
        "tool_ms": split["tool_ms"], "approval_ms": split["approval_ms"],
        "muse_ms": split["muse_ms"],
        "needs_approval_tool": r.get("needs_approval"),
        "status": status, "timeout_seconds": timeout,
        "command": r["command"],
        "wall_ms": r["wall_ms"], "exit_code": r["exit_code"],
        "reply": r["reply"], "calls": r["calls"], "timeline": r["timeline"],
        "api_ms": r.get("api_ms"), "ttft_ms": r.get("ttft_ms"),
        "num_turns": r.get("num_turns"), "cost_usd": r.get("cost_usd"),
        "allowance_start": allowance_start,
        "allowance_end": r.get("allowance_end"),
        "allowance_delta": list_pricing.allowance_delta(
            allowance_start, r.get("allowance_end"))
        if allowance_start or r.get("allowance_end") else None,
        "totals": r.get("totals"),
        "metrics_unavailable": status == "completed" and not r["calls"],
        "error": (f"waiting for approval: {r['needs_approval']}"
                  if r.get("needs_approval") else None)
                 or r.get("error_override")
                 or (stderr_tail if status != "completed" else None),
    })
    rates = pricing if pricing is not None else env_pricing()
    reported = report["cost_usd"]
    # For a muse-* model, a reported cost is priced from
    # Anthropic's list by Claude Code, which is not a Meta price.
    # When the user supplied their own rates for that model, their
    # figure is the honest one and wins over the reported one.
    prefer_own = reported is not None \
        and str(report["model"] or "").startswith("muse-") \
        and pricing_for(report["model"], rates) is not None
    # Precedence: the user's own rates, then Meta's published
    # list (muse-wonder-1.0 on paid paths only), then a reported
    # figure. A muse-* reported figure stays stored but hidden.
    list_ok = provider in ("anthropic", "claude-code") \
        and report["model"] in list_pricing.LIST_PRICES
    if reported is not None and not prefer_own and not list_ok:
        report["cost_source"] = "reported"
    else:
        cost, used = compute_cost(
            report["model"], report["totals"], report["calls"], rates)
        if cost is not None:
            report["cost_usd"] = cost
            report["cost_source"] = "computed"
            report["pricing"] = used
        else:
            listed, list_used = list_pricing.list_cost(
                report["model"], report["totals"], report["calls"]) \
                if list_ok else (None, None)
            if listed is not None:
                report["cost_usd"] = listed
                report["cost_source"] = "list"
                report["pricing"] = list_used
            elif reported is not None:
                report["cost_source"] = "reported"
    write_run(run_dir, report)
    with _PRINT_LOCK:
        print_summary(report, r, run_dir)
    return report


def _fmt_bucket(ms):
    return "–" if ms is None else f"{ms / 1000:.1f} s"


def record_watch_turn(turn, session_id, provider="muse-watch",
                      command="./run-muse --watch", quiet=False):
    """Append one finished interactive turn as a run."""
    run_id, run_dir = new_run_dir()
    (run_dir / "prompt.md").write_text(turn["prompt"])
    split = turn["split"]
    report = dict(BASE_REPORT)
    report.update({
        "at": turn["at"], "run_id": run_id, "prompt": turn["prompt"],
        "model": turn["model"], "provider": provider,
        "session_id": session_id, "context_mode": "interactive",
        "harness_version": turn["version"],
        "tool_ms": split["tool_ms"],
        "approval_ms": split["approval_ms"],
        "muse_ms": split["muse_ms"],
        "status": "completed",
        "command": command,
        "wall_ms": turn["wall_ms"], "exit_code": 0,
        "calls": turn["calls"], "timeline": turn.get("timeline") or [],
        "turn_index": turn["index"],
    })
    write_run(run_dir, report)
    if quiet:
        return report
    print(f"turn {turn['index']} · wall {_fmt_bucket(turn['wall_ms'])}"
          f" · model {_fmt_bucket(split['model_ms'])}"
          f" · tools {_fmt_bucket(split['tool_ms'])}"
          f" · approval {_fmt_bucket(split['approval_ms'])}"
          f" · Muse {_fmt_bucket(split['muse_ms'])}"
          f" · {len(turn['calls'])} call(s)", flush=True)
    return report


def run_watch(session_arg=None):
    """Attach read-only to a Muse session and record its turns.

    Never starts, stops or answers Muse: the log file is only read.
    Runs until the session ends or Ctrl+C.
    """
    if session_arg:
        path = muse_log.session_log_path(session_arg)
        session_id = session_arg
    else:
        path = muse_log.newest_session_path()
        session_id = path.parent.name if path else None
    if not path or not Path(path).is_file():
        print("No Muse session log found to watch.", file=sys.stderr)
        return
    print(f"Watching session {session_id} read-only. "
          f"Run Muse normally in another terminal. Ctrl+C stops "
          f"watching.{_ui_suffix()}", flush=True)
    recorded = set()
    try:
        while True:
            records = muse_log.read_records(path)
            for turn in muse_log.split_turns(records):
                if turn["index"] not in recorded:
                    recorded.add(turn["index"])
                    record_watch_turn(turn, session_id)
            if any(e.get("payload_type") == "session.end"
                   for e in records):
                print("Session ended.", flush=True)
                return
            time.sleep(1)
    except KeyboardInterrupt:
        # split_turns only returns the trailing turn once the session
        # has ended, so this only catches turns that closed in the
        # last poll second.
        records = muse_log.read_records(path)
        turns = muse_log.split_turns(records)
        for turn in turns:
            if turn["index"] not in recorded:
                recorded.add(turn["index"])
                record_watch_turn(turn, session_id)
        print("\nStopped watching.", flush=True)


_TURN_PROVIDERS = ("muse-watch", "muse-retro")


def _index_entries():
    index = RUNS / "index.jsonl"
    entries = []
    if index.is_file():
        for line in index.read_text(errors="replace").splitlines():
            try:
                entries.append(json.loads(line))
            except Exception:
                continue
    return entries


def retro_plan(entries, sessions):
    """(session_id, turn) pairs still missing from the index.

    A session already recorded by the launcher (any provider other
    than the turn importers) is skipped whole. Its turns are runs
    with launcher-measured walls already. A turn recorded by watch
    or an earlier retro run is skipped by (session_id, turn_index).
    """
    owned = {e.get("session_id") for e in entries
             if e.get("session_id")
             and e.get("provider") not in _TURN_PROVIDERS}
    seen = {(e.get("session_id"), e.get("turn_index")) for e in entries
            if e.get("provider") in _TURN_PROVIDERS
            and e.get("session_id")}
    plan = []
    for session_id, turns in sessions:
        if session_id in owned:
            continue
        for turn in turns:
            if (session_id, turn["index"]) not in seen:
                plan.append((session_id, turn))
    return plan


def run_retro():
    """Record finished turns from every Muse session log on disk.

    Read-only on the logs. Only closed turns import, the same rule
    watch uses, so a session still running contributes nothing in
    flight. Rerunning imports only turns closed since the last run.
    """
    files = sorted(muse_log.sessions_dir().glob("**/session.jsonl"))
    if not files:
        print("No Muse session logs found.", flush=True)
        return
    sessions = []
    seen_ids = set()
    for path in files:
        session_id = path.parent.name
        if session_id in seen_ids:
            continue
        seen_ids.add(session_id)
        records = muse_log.read_records(path)
        turns = muse_log.split_turns(records)
        if not turns:
            continue
        first = min((e.get("recorded_at") for e in records
                     if e.get("recorded_at") is not None), default=0)
        sessions.append((first, session_id, turns))
    sessions.sort(key=lambda s: (s[0], s[1]))
    plan = retro_plan(_index_entries(),
                      [(sid, turns) for _, sid, turns in sessions])
    planned = {}
    for session_id, _turn in plan:
        planned[session_id] = planned.get(session_id, 0) + 1
    candidates = sum(len(turns) for _, _, turns in sessions)
    for _first, session_id, turns in sessions:
        imported = planned.get(session_id, 0)
        if imported:
            print(f"session {session_id}: imported {imported} turn(s), "
                  f"skipped {len(turns) - imported}", flush=True)
    for session_id, turn in plan:
        record_watch_turn(turn, session_id, provider="muse-retro",
                          command="./run-muse --retro", quiet=True)
    print(f"Retro done. Imported {len(plan)} turn(s) from "
          f"{len(planned)} session(s). Skipped "
          f"{candidates - len(plan)} turn(s) already recorded."
          f"{_ui_suffix()}", flush=True)


def parse_compare_models(text):
    out = []
    for entry in text.split(","):
        entry = entry.strip()
        if not entry:
            continue
        if ":" in entry:
            provider, model = entry.split(":", 1)
        else:
            provider, model = entry, default_model(entry)
        out.append((provider.strip(), model.strip()))
    return out


def compare_models_for(mode):
    """The (provider, model) list for a compare mode.

    meta and claude are presets. custom (and None) reads
    COMPARE_MODELS. Preset env vars are read at call time so a
    shell or .env change takes effect without an edit here.
    """
    if mode == "meta":
        return parse_compare_models(
            os.environ.get("COMPARE_META", COMPARE_META))
    if mode == "claude":
        return parse_compare_models(
            os.environ.get("COMPARE_CLAUDE", COMPARE_CLAUDE))
    if mode in ("custom", None):
        return parse_compare_models(
            os.environ.get("COMPARE_MODELS", COMPARE_MODELS))
    raise ValueError(
        f"unknown compare mode '{mode}' "
        f"(valid: {', '.join(COMPARE_MODES)})")


def mode_label(mode):
    return {"single": "single", "meta": "meta vs meta",
            "claude": "meta vs claude", "custom": "custom"}.get(mode, mode)


def describe_mode(mode):
    if mode == "single":
        return "Mode: single"
    models = ", ".join(f"{provider}/{model}"
                       for provider, model in compare_models_for(mode))
    return f"Mode: {mode_label(mode)} ({models})"


def exit_code_for(status):
    if status == "completed":
        return 0
    if status == "interrupted":
        return 130
    return 1


def _run_round_raced(prompt, order, minimal, timeout, comparison_id,
                     round_no, mode):
    """One compare round with every leg running at once.

    Returns one status per leg, in leg order. Ctrl+C lands on the
    main thread while it joins. It sets the shared stop Event, and
    each leg stops its own process and records interrupted through
    the usual paths. A leg exception is re-raised here after every
    leg has been joined. It is never swallowed inside a thread.
    """
    stop_event = threading.Event()
    reports = [None] * len(order)
    errors = []

    def leg(index, provider, model):
        try:
            reports[index] = run_prompt(
                prompt, provider=provider, model=model, minimal=minimal,
                timeout=timeout, comparison_id=comparison_id,
                compare_round=round_no, compare_mode=mode,
                raced=True, stop_event=stop_event)
        except BaseException as exc:
            errors.append(exc)

    threads = [threading.Thread(target=leg, args=(i, provider, model))
               for i, (provider, model) in enumerate(order)]
    for t in threads:
        t.start()
    try:
        for t in threads:
            t.join()
    except KeyboardInterrupt:
        stop_event.set()
        for t in threads:
            t.join()
    if errors:
        raise errors[0]
    return [r["status"] for r in reports]


def run_compare(prompt, mode, minimal, timeout, repeat, race=False):
    comparison_id = uuid.uuid4().hex[:8]
    models = compare_models_for(mode)
    verb = "Racing" if race and len(models) > 1 else "Comparing"
    print(f"{verb} {len(models)} model(s), {repeat} round(s), "
          f"set {comparison_id}")
    statuses = []
    for round_no, order in compare_schedule(models, repeat):
        if race and len(order) > 1:
            round_statuses = _run_round_raced(
                prompt, order, minimal, timeout, comparison_id,
                round_no, mode)
            statuses.extend(round_statuses)
            if "interrupted" in round_statuses:
                break
            continue
        for provider, model in order:
            report = run_prompt(prompt, provider=provider, model=model,
                                minimal=minimal, timeout=timeout,
                                comparison_id=comparison_id,
                                compare_round=round_no, compare_mode=mode)
            statuses.append(report["status"])
            if report["status"] == "interrupted":
                break
        if "interrupted" in statuses:
            break
    done = sum(1 for status in statuses if status == "completed")
    closing = f"Compare set {comparison_id} done: {done} completed of {len(statuses)}."
    if ui_enabled():
        closing += f" UI: {UI_URL}compare/{comparison_id}"
    print(closing)
    if "interrupted" in statuses:
        return 130
    if any(status != "completed" for status in statuses):
        return 1
    return 0


SUITE_DEFAULT = ROOT / "golden-prompts.json"


def load_suite(path):
    """Golden prompts from a JSON file: {\"prompts\": [entry, ...]}.

    Each entry needs a unique non-empty name and prompt. Provider,
    model and minimal are optional per entry. Raises ValueError with
    a plain message for anything else, so main can show it as-is.
    """
    return _suite_entries(_read_suite_data(path), Path(path))


def _read_suite_data(path):
    """Read and parse a suite file once. Plain errors only."""
    path = Path(path)
    try:
        text = path.read_text()
    except UnicodeDecodeError:
        raise ValueError(f"suite file {path} is not valid UTF-8 text")
    except OSError as e:
        raise ValueError(
            f"cannot read suite file {path}: {e.strerror or e}")
    try:
        return json.loads(text)
    except Exception:
        raise ValueError(f"suite file {path} is not valid JSON")


def _suite_entries(data, path):
    raw = data.get("prompts") if isinstance(data, dict) else None
    if not isinstance(raw, list) or not raw:
        raise ValueError("suite file needs a non-empty 'prompts' list")
    entries = []
    seen = set()
    for i, entry in enumerate(raw):
        if not isinstance(entry, dict):
            raise ValueError(f"suite entry {i + 1} needs non-empty "
                             "'name' and 'prompt'")
        name = entry.get("name")
        prompt = entry.get("prompt")
        prompt_file = entry.get("file")
        if not isinstance(name, str) or not name.strip():
            raise ValueError(
                f"suite entry {i + 1} needs non-empty 'name' and "
                "'prompt'")
        if prompt is not None and prompt_file is not None:
            raise ValueError(
                f"suite entry '{name}' has both 'prompt' and 'file'. "
                "Give one only")
        if prompt_file is not None:
            if not isinstance(prompt_file, str) or not prompt_file.strip():
                raise ValueError(
                    f"suite entry '{name}' needs a non-empty 'file'")
            file_path = Path(prompt_file)
            if not file_path.is_absolute():
                file_path = path.parent / file_path
            try:
                prompt = file_path.read_text()
            except UnicodeDecodeError:
                raise ValueError(
                    f"prompt file {file_path} for suite entry "
                    f"'{name}' is not valid UTF-8 text")
            except OSError as e:
                raise ValueError(
                    f"cannot read prompt file {file_path} for suite "
                    f"entry '{name}': {e.strerror or e}")
        if not isinstance(prompt, str) or not prompt.strip():
            raise ValueError(
                f"suite entry {i + 1} needs non-empty 'name' and "
                "'prompt'")
        skip = entry.get("skip", False)
        if not isinstance(skip, bool):
            raise ValueError(
                f"suite entry '{name}' needs 'skip' to be true or false")
        entry_timeout = entry.get("timeout_seconds")
        if entry_timeout is not None and (
                isinstance(entry_timeout, bool)
                or not isinstance(entry_timeout, int)
                or entry_timeout < 1):
            raise ValueError(
                f"suite entry '{name}' needs 'timeout_seconds' to be "
                "a whole number of seconds, at least 1")
        if name in seen:
            raise ValueError(f"duplicate suite prompt name '{name}'")
        seen.add(name)
        entries.append({
            "name": name, "prompt": prompt,
            "provider": entry.get("provider") or DEFAULT_PROVIDER,
            "model": entry.get("model"),
            "minimal": bool(entry.get("minimal")),
            "skip": skip, "timeout_seconds": entry_timeout,
        })
    return entries


def _positive_number(value, key, whole=False):
    if value is None:
        return None
    bad = isinstance(value, bool) \
        or not isinstance(value, int if whole else (int, float))
    if bad or (value < 1 if whole else value <= 0):
        raise ValueError(f"suite settings need '{key}' to be a "
                         "positive number")
    return value


def load_manifest(path):
    """Suite file plus its optional settings block.

    Returns {"settings": {...}, "entries": [...]}. Settings keys:
    concurrency, timeout_seconds, repeat, max_cost_usd,
    max_runtime_seconds, pricing. Raises ValueError with a plain
    message for anything bad, like load_suite.
    """
    path = Path(path)
    data = _read_suite_data(path)
    entries = _suite_entries(data, path)
    raw = data.get("settings") if isinstance(data, dict) else None
    if raw is None:
        raw = {}
    if not isinstance(raw, dict):
        raise ValueError("suite 'settings' must be an object")
    concurrency = raw.get("concurrency", 1)
    if isinstance(concurrency, bool) \
            or not isinstance(concurrency, int) \
            or not 1 <= concurrency <= 8:
        raise ValueError("suite settings need 'concurrency' to be "
                         "a whole number from 1 to 8")
    timeout_seconds = raw.get("timeout_seconds")
    if timeout_seconds is not None and (
            isinstance(timeout_seconds, bool)
            or not isinstance(timeout_seconds, int)
            or timeout_seconds < 1):
        raise ValueError("suite settings need 'timeout_seconds' to "
                         "be a whole number of seconds, at least 1")
    settings = {
        "concurrency": concurrency,
        "timeout_seconds": timeout_seconds,
        "repeat": _positive_number(raw.get("repeat"), "repeat",
                                   whole=True),
        "max_cost_usd": _positive_number(raw.get("max_cost_usd"),
                                         "max_cost_usd"),
        "max_runtime_seconds": _positive_number(
            raw.get("max_runtime_seconds"), "max_runtime_seconds"),
        "pricing": parse_pricing(raw.get("pricing"),
                                 f"settings in {path}"),
    }
    return {"settings": settings, "entries": entries}


def previous_suite_version(provider):
    """Last harness version a suite run recorded for this provider."""
    index = RUNS / "index.jsonl"
    last = None
    if index.is_file():
        for line in index.read_text(errors="replace").splitlines():
            try:
                entry = json.loads(line)
            except Exception:
                continue
            if entry.get("suite_id") \
                    and entry.get("provider") == provider \
                    and entry.get("harness_version"):
                last = entry["harness_version"]
    return last


def suite_version_notice(previous, current, provider):
    if previous and current and previous != current:
        return (f"Harness changed since the last suite run: "
                f"{provider} was {previous}, now {current}.")
    return None


def effective_timeout(entry, settings, cli_timeout):
    """Timeout precedence: flag, entry, settings, provider default."""
    if cli_timeout is not None:
        return cli_timeout
    if entry.get("timeout_seconds") is not None:
        return entry["timeout_seconds"]
    if settings.get("timeout_seconds") is not None:
        return settings["timeout_seconds"]
    return default_timeout(entry["provider"])


def suite_state_path(path):
    path = Path(path)
    return path.parent / (path.stem + ".state.json")


def load_state(path):
    """Resume state stored beside a suite file, or None.

    Raises ValueError with a plain message when the file exists
    but cannot be trusted. A suite must never silently rerun
    finished entries because its state file was damaged.
    """
    state_path = suite_state_path(path)
    if not state_path.is_file():
        return None
    try:
        state = json.loads(state_path.read_text())
    except Exception:
        raise ValueError(f"state file {state_path} is not valid JSON. "
                         "Fix it or delete it and start again")
    if not isinstance(state, dict) \
            or state.get("manifest") != Path(path).name \
            or not state.get("suite_id") \
            or not isinstance(state.get("entries"), dict):
        raise ValueError(f"state file {state_path} does not belong "
                         f"to {Path(path).name}. Delete it if it is "
                         "stale")
    return state


def save_state(path, state):
    state_path = suite_state_path(path)
    tmp = state_path.with_name(state_path.name + ".tmp")
    tmp.write_text(json.dumps(state, indent=2))
    os.replace(tmp, state_path)


def _entry_model(entry):
    # Mirror what run_prompt records, so pricing keys line up.
    # The echo provider always records its model as "echo".
    return recorded_model(
        entry["provider"],
        entry.get("model") or default_model(entry["provider"]))


def _priced_text(entry, pricing):
    if pricing_for(_entry_model(entry), pricing):
        return "priced"
    if entry["provider"] == "claude-code" \
            and not _entry_model(entry).startswith("muse-"):
        return "cost reported by Claude Code"
    return "unpriced"


def print_suite_plan(path, settings, entries, pricing, cli_timeout,
                     repeat, resume, fresh=False):
    """The --dry-run listing. Prints only. Runs nothing."""
    print(f"Suite file: {path}")
    print(f"{len(entries)} prompt(s), {repeat} repeat(s) each, "
          f"concurrency {settings['concurrency']}")
    if settings.get("max_cost_usd") is not None:
        print(f"Cost budget: stop starting new entries at "
              f"${settings['max_cost_usd']:.2f} of recorded cost")
    if settings.get("max_runtime_seconds") is not None:
        print(f"Runtime budget: stop starting new entries after "
              f"{settings['max_runtime_seconds']} seconds")
    state = None
    if resume and fresh:
        print("Fresh: saved progress will be ignored. Every entry "
              "runs again under a new suite id")
    elif resume:
        try:
            state = load_state(path)
        except ValueError as e:
            print(f"State problem: {e}")
            return 1
        if state:
            done = sum(1 for v in state["entries"].values()
                       if v.get("status") == "completed")
            print(f"Resume: suite {state['suite_id']}, "
                  f"{done} already completed")
        else:
            print("Resume: no state file yet. A fresh suite id "
                  "will be recorded on the first real run")
    any_paid = False
    any_unpriced = False
    for entry in entries:
        paid = entry["provider"] in PAID_PROVIDERS
        any_paid = any_paid or (paid and not entry["skip"])
        priced = _priced_text(entry, pricing)
        any_unpriced = any_unpriced or priced == "unpriced"
        parts = [entry["name"],
                 f"{entry['provider']}/{_entry_model(entry)}",
                 f"timeout "
                 f"{effective_timeout(entry, settings, cli_timeout)} s",
                 priced]
        if paid:
            parts.append("PAID")
        if entry["skip"]:
            parts.append("skip")
        print("- " + " · ".join(parts))
    if any_paid and settings["concurrency"] > 1:
        print("Paid entries can run at the same time at this "
              "concurrency. They spend in parallel")
    if settings.get("max_cost_usd") is not None and any_unpriced:
        print("Some entries are unpriced. The cost budget counts "
              "priced and reported runs only")
    print("Dry run only. Nothing was run")
    return 0


def run_suite(path, timeout=None, repeat=None, dry_run=False,
              resume=False, fresh=False, manifest=None):
    if manifest is None:
        manifest = load_manifest(path)
    settings, entries = manifest["settings"], manifest["entries"]
    pricing = dict(env_pricing())
    pricing.update(settings["pricing"])
    if repeat is None:
        repeat = settings["repeat"] or 3
    if dry_run:
        return print_suite_plan(path, settings, entries, pricing,
                                timeout, repeat, resume, fresh=fresh)
    state = None
    if resume:
        state = None if fresh else load_state(path)
        if state is None:
            state = {"manifest": Path(path).name,
                     "suite_id": uuid.uuid4().hex[:8], "entries": {}}
            save_state(path, state)
        suite_id = state["suite_id"]
    else:
        suite_id = uuid.uuid4().hex[:8]
    print(f"Suite {suite_id}: {len(entries)} prompt(s), "
          f"{repeat} repeat(s) each")
    providers = []
    for entry in entries:
        if entry["provider"] not in providers:
            providers.append(entry["provider"])
    for provider in providers:
        notice = suite_version_notice(
            previous_suite_version(provider),
            harness_version(provider), provider)
        if notice:
            print(notice)
    work = [(f"{entry['name']}#{round_no}", entry)
            for round_no in range(1, repeat + 1) for entry in entries]
    done_before = set()
    spent = 0.0
    if state:
        entry_by_key = dict(work)
        for key, record in state["entries"].items():
            if record.get("status") == "completed":
                done_before.add(key)
            # Failed, timed out and interrupted runs cost money too.
            # The budget must count every recorded cost from earlier
            # launches, not only the successful ones.
            record_model = record.get("model")
            if record_model is None and key in entry_by_key:
                record_model = _entry_model(entry_by_key[key])
            spent += counted_cost(record_model,
                                  record.get("cost_usd"),
                                  record.get("cost_source")) or 0
        already = sum(1 for key, _ in work if key in done_before)
        if already:
            print(f"Resuming. {already} already completed "
                  "and will not run again")
    if settings.get("max_cost_usd") is not None and any(
            not e["skip"] and _priced_text(e, pricing) == "unpriced"
            for e in entries):
        print("Warning: some entries are unpriced. The cost budget "
              "counts priced and reported runs only")
    state_lock = threading.Lock()
    budget = {"spent": spent, "reason": None}
    started = time.monotonic()
    stop_event = threading.Event()
    results = {}

    def mark(key, record):
        if state is None:
            return
        with state_lock:
            state["entries"][key] = record
            save_state(path, state)

    def attempt(key, entry):
        if stop_event.is_set():
            return "not_started"
        with state_lock:
            if settings.get("max_cost_usd") is not None \
                    and budget["spent"] >= settings["max_cost_usd"]:
                budget["reason"] = "cost budget reached"
                return "not_started"
            remaining = None
            if settings.get("max_runtime_seconds") is not None:
                remaining = settings["max_runtime_seconds"] \
                    - (time.monotonic() - started)
                if remaining < 1:
                    budget["reason"] = "runtime budget reached"
                    return "not_started"
        entry_timeout = effective_timeout(entry, settings, timeout)
        if remaining is not None:
            entry_timeout = min(entry_timeout, int(remaining))
        mark(key, {"status": "running", "run_id": None,
                   "cost_usd": None, "wall_seconds": None,
                   "updated_at": datetime.now(timezone.utc).isoformat()})
        report = run_prompt(
            entry["prompt"], provider=entry["provider"],
            model=entry["model"], minimal=entry["minimal"],
            timeout=entry_timeout, suite_id=suite_id,
            suite_prompt=entry["name"], pricing=pricing,
            stop_event=stop_event
            if settings["concurrency"] > 1 else None)
        with state_lock:
            budget["spent"] += counted_cost(
                report.get("model") or _entry_model(entry),
                report.get("cost_usd"),
                report.get("cost_source")) or 0
        if report["status"] == "interrupted":
            stop_event.set()
        mark(key, {"status": report["status"],
                   "run_id": report.get("run_id"),
                   "model": report.get("model"),
                   "cost_usd": report.get("cost_usd"),
                   "cost_source": report.get("cost_source"),
                   "wall_seconds": (report["wall_ms"] / 1000
                                    if report.get("wall_ms") is not None
                                    else None),
                   "updated_at": datetime.now(timezone.utc).isoformat()})
        return report["status"]

    pending = []
    for key, entry in work:
        if entry["skip"]:
            print(f"Skipping {entry['name']} (skip is true)")
            results[key] = "skipped"
        elif key in done_before:
            results[key] = "completed"
        else:
            pending.append((key, entry))
    interrupted = False
    if settings["concurrency"] > 1 and len(pending) > 1:
        errors = []
        with concurrent.futures.ThreadPoolExecutor(
                max_workers=settings["concurrency"]) as pool:
            futures = {pool.submit(attempt, key, entry): key
                       for key, entry in pending}
            try:
                for future in concurrent.futures.as_completed(futures):
                    key = futures[future]
                    try:
                        results[key] = future.result()
                    except BaseException as exc:
                        errors.append(exc)
                        results[key] = "failed"
            except KeyboardInterrupt:
                interrupted = True
                stop_event.set()
                for future in futures:
                    future.cancel()
        # Leaving the pool waits for legs already running. They
        # finish through their normal paths and record real
        # statuses, so harvest those here. Nothing may relabel a
        # finished leg as not started, or a resume would bill it
        # a second time. Only truly cancelled legs never ran.
        for future, key in futures.items():
            if key in results:
                continue
            if future.cancelled():
                results[key] = "not_started"
                continue
            try:
                results[key] = future.result()
            except BaseException as exc:
                errors.append(exc)
                results[key] = "failed"
        if errors:
            raise errors[0]
    else:
        for key, entry in pending:
            if interrupted:
                results[key] = "not_started"
                continue
            try:
                results[key] = attempt(key, entry)
            except KeyboardInterrupt:
                results[key] = "interrupted"
                mark(key, {"status": "interrupted", "run_id": None,
                           "cost_usd": None, "wall_seconds": None,
                           "updated_at":
                           datetime.now(timezone.utc).isoformat()})
            # run_prompt records most interrupts itself and returns
            # an interrupted report instead of raising. Either way
            # the suite stops here. It must not start the next
            # entry and wait for a second Ctrl+C.
            if results[key] == "interrupted":
                interrupted = True
    if "interrupted" in results.values():
        interrupted = True
    if state:
        terminal = ("completed", "failed", "timeout",
                    "needs_approval", "interrupted")
        for key, _entry in pending:
            if results.get(key) == "not_started":
                with state_lock:
                    existing = state["entries"].get(key, {}) \
                        .get("status")
                if existing in terminal:
                    results[key] = existing
                    continue
                mark(key, {"status": "not_started", "run_id": None,
                           "cost_usd": None, "wall_seconds": None,
                           "reason": budget["reason"]
                           or ("interrupted" if interrupted else None),
                           "updated_at":
                           datetime.now(timezone.utc).isoformat()})
    if budget["reason"]:
        print(f"Stopped starting new entries. {budget['reason']}. "
              f"Recorded cost so far: ${budget['spent']:.4f}")
    counts = {}
    for status in results.values():
        counts[status] = counts.get(status, 0) + 1
    done = counts.get("completed", 0)
    closing = f"Suite {suite_id} done: {done} completed of {len(work)}."
    if ui_enabled():
        closing += f" UI: {UI_URL}radar"
    print(closing)
    print("Counts: " + ", ".join(
        f"{name} {counts[name]}" for name in sorted(counts))
        + f". Recorded cost: ${budget['spent']:.4f}")
    if interrupted:
        return 130
    if any(status not in ("completed", "skipped")
           for status in results.values()):
        return 1
    return 0


def handle_command(line, state):
    """Classify one prompt-loop line. Pure: state is only read.

    Returns {"action", "mode", "text"} where action is "prompt",
    "message", "quit", or "none", and mode is the mode after the
    line. The caller prints text and applies mode.
    """
    mode = state.get("mode", "single")
    text = (line or "").strip()
    if not text:
        return {"action": "none", "mode": mode, "text": ""}
    if text in ("/quit", "/exit", "quit", "exit"):
        return {"action": "quit", "mode": mode, "text": ""}
    if text == "/help":
        return {"action": "message", "mode": mode, "text":
                "Commands: /mode, /mode single|meta|claude|custom, "
                "/help, /quit\n"
                "Modes: single (one run), meta (Meta vs Meta), "
                "claude (Meta vs Claude), custom (COMPARE_MODELS)\n"
                "Ctrl+C stops a run and records it as interrupted."}
    if text == "/mode":
        return {"action": "message", "mode": mode,
                "text": describe_mode(mode)}
    if text.startswith("/mode "):
        wanted = text[len("/mode "):].strip()
        if wanted in ("single",) + COMPARE_MODES:
            text_out = describe_mode(wanted)
            if wanted == "claude":
                notices = []
                for m_provider, m_model in compare_models_for("claude"):
                    if m_provider in PAID_PROVIDERS:
                        notice = paid_notice(m_model)
                        if notice not in notices:
                            notices.append(notice)
                for notice in notices:
                    text_out += "\n" + notice
            return {"action": "message", "mode": wanted,
                    "text": text_out}
        return {"action": "message", "mode": mode,
                "text": f"Unknown mode '{wanted}'. "
                        "Valid modes: single, meta, claude, custom."}
    return {"action": "prompt", "mode": mode, "text": text}


def compare_schedule(models, repeat):
    """One (round, order) pair per round. Even rounds reverse the
    order so neither side always goes first."""
    return [(n, models if n % 2 == 1 else list(reversed(models)))
            for n in range(1, repeat + 1)]


def main():
    # A launcher started in the background of a non-interactive shell
    # inherits SIGINT as ignored, so kill -INT would never land.
    signal.signal(signal.SIGINT, signal.default_int_handler)
    parser = argparse.ArgumentParser(prog="run-muse")
    parser.add_argument("prompt", nargs="*", help="prompt text")
    parser.add_argument("--provider", default=DEFAULT_PROVIDER)
    parser.add_argument("--model", default=None)
    parser.add_argument("--minimal", action="store_true",
                        help="repeatable context: no reminders, no foreign context")
    parser.add_argument("--timeout", type=int, default=None,
                        help="per-run timeout in seconds (default 1800, "
                             "300 for claude-code and anthropic)")
    parser.add_argument("--compare", default=None, choices=COMPARE_MODES,
                        help="compare mode: meta, claude, or custom "
                             "(COMPARE_MODELS)")
    parser.add_argument("--repeat", type=int, default=None,
                        help="compare rounds, alternating order (default 1)")
    parser.add_argument("--race", action="store_true",
                        help="run the legs of each compare round at the "
                             "same time (needs --compare)")
    parser.add_argument("--watch", nargs="?", const="", default=None,
                        metavar="SESSION",
                        help="watch a Muse session read-only (newest "
                             "when no session id is given) and record "
                             "each finished turn")
    parser.add_argument("--retro", action="store_true",
                        help="record finished turns from every Muse "
                             "session log already on disk")
    parser.add_argument("--suite", "--manifest", nargs="?",
                        const=str(SUITE_DEFAULT),
                        default=None, metavar="FILE",
                        help="run a prompt suite or manifest file "
                             "(default file golden-prompts.json) and "
                             "stamp each run for the regression radar")
    parser.add_argument("--dry-run", action="store_true",
                        help="with --suite, list what would run and "
                             "run nothing")
    parser.add_argument("--resume", action="store_true",
                        help="with --suite, record progress in a "
                             "state file beside the suite file and "
                             "skip entries already completed")
    parser.add_argument("--fresh", action="store_true",
                        help="with --resume, ignore saved progress "
                             "and run every entry again")
    args = parser.parse_args()
    if args.repeat is not None and not args.compare \
            and args.suite is None:
        parser.error("--repeat needs --compare or --suite")
    if args.race and not args.compare:
        parser.error("--race needs --compare")
    if args.suite is not None and (args.prompt or args.compare
                                   or args.watch is not None or args.retro):
        parser.error("--suite takes no prompt, --compare, --watch or --retro")
    if (args.dry_run or args.resume or args.fresh) \
            and args.suite is None:
        parser.error("--dry-run, --resume and --fresh need --suite")
    if args.fresh and not args.resume:
        parser.error("--fresh needs --resume")
    if args.watch is not None and (args.prompt or args.compare):
        parser.error("--watch takes no prompt or --compare")
    if args.retro and (args.prompt or args.compare
                       or args.watch is not None):
        parser.error("--retro takes no prompt, --compare or --watch")
    mode = args.compare
    args.model = args.model or default_model(args.provider)
    repeat = args.repeat if args.repeat is not None else 1
    if (mode is not None or args.suite is not None) and repeat < 1:
        parser.error("--repeat must be at least 1")
    try:
        env_pricing()
    except ValueError as e:
        parser.error(str(e))
    if args.suite is not None:
        try:
            manifest = load_manifest(args.suite)
            if args.resume and not args.fresh:
                load_state(args.suite)
        except ValueError as e:
            parser.error(str(e))
        if args.dry_run:
            return run_suite(args.suite, args.timeout, args.repeat,
                             dry_run=True, resume=args.resume,
                             fresh=args.fresh, manifest=manifest)
        ensure_ui()
        return run_suite(args.suite, args.timeout, args.repeat,
                         resume=args.resume, fresh=args.fresh,
                         manifest=manifest)
    ensure_ui()
    if args.watch is not None:
        run_watch(args.watch or None)
        return 0
    if args.retro:
        run_retro()
        return 0
    prompt = " ".join(args.prompt).strip()
    if prompt and mode is not None:
        return run_compare(prompt, mode, args.minimal, args.timeout, repeat,
                           race=args.race)
    if prompt:
        report = run_prompt(prompt, provider=args.provider,
                            model=args.model, minimal=args.minimal,
                            timeout=args.timeout)
        return exit_code_for(report["status"])
    state = {"mode": mode or "single"}
    if state["mode"] == "single":
        context = "minimal" if args.minimal else "full"
        print(f"Model: {args.provider}/{args.model} ({context} context). "
              f"Type a prompt, /quit to exit.{_ui_suffix()}")
    else:
        print(f"{describe_mode(state['mode'])}. Type a prompt, "
              f"/mode to switch, /quit to exit.{_ui_suffix()}")
    while True:
        prompt_str = "muse> " if state["mode"] == "single" \
            else f"muse[{state['mode']}]> "
        try:
            line = input(prompt_str)
        except (EOFError, KeyboardInterrupt):
            print()
            break
        result = handle_command(line, state)
        state["mode"] = result["mode"]
        if result["action"] == "quit":
            break
        if result["action"] == "message":
            print(result["text"])
            continue
        if result["action"] != "prompt":
            continue
        try:
            if state["mode"] == "single":
                run_prompt(result["text"], provider=args.provider,
                           model=args.model, minimal=args.minimal,
                           timeout=args.timeout)
            else:
                run_compare(result["text"], state["mode"],
                            args.minimal, args.timeout, repeat,
                            race=args.race)
        except KeyboardInterrupt:
            print("\nInterrupted.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
