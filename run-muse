def _pricing_pair(value, where):
    if not isinstance(value, dict):
        raise ValueError(f"pricing in {where} needs input_per_mtok "
                         "and output_per_mtok")
    pair = {}
    for key in ("input_per_mtok", "output_per_mtok"):
        rate = value.get(key)
        if isinstance(rate, bool) \
                or not isinstance(rate, (int, float)) or rate < 0:
            raise ValueError(f"pricing in {where} needs a number at "
                             f"or above zero for '{key}'")
        pair[key] = float(rate)
    return pair


def parse_pricing(raw, where="BENCH_PRICING"):
    """User supplied rates as {model: pair}, "*" for any model.

    Accepts a dict or a JSON string. A flat pair means any model.
    Returns {} when nothing is set. Raises ValueError with a plain
    message for anything else, so callers can show it as-is.
    """
    if raw is None or raw == "":
        return {}
    if isinstance(raw, str):
        try:
            raw = json.loads(raw)
        except Exception:
            raise ValueError(f"pricing in {where} is not valid JSON")
    if not isinstance(raw, dict):
        raise ValueError(f"pricing in {where} must be an object")
    if "input_per_mtok" in raw or "output_per_mtok" in raw:
        return {"*": _pricing_pair(raw, where)}
    pricing = {}
    for model, value in raw.items():
        if not isinstance(model, str) or not model:
            raise ValueError(f"pricing in {where} has a bad model key")
        pricing[model] = _pricing_pair(value, where)
    return pricing


def env_pricing():
